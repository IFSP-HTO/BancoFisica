<<echo=FALSE, results=hide>>=
L <- sample(c(0.5,0.8,1.0,1.2),1)
v <- sample(c(80,100,120,160),1)
f1 <- v/(2*L)
f2 <- 2*f1
fmt <- function(z) formatC(z,format="f",digits=1,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}

Uma corda de comprimento $L=\Sexpr{L}\,\mathrm{m}$ está fixa nas duas extremidades. A velocidade das ondas transversais na corda é $v=\Sexpr{v}\,\mathrm{m/s}$.

Determine:
\begin{answerlist}
  \item a frequência fundamental $f_1$;
  \item a frequência do segundo harmônico $f_2$.
\end{answerlist}

\end{question}

\begin{solution}

Para uma corda fixa nas duas extremidades,
\[
f_n=n\frac{v}{2L}.
\]
Assim,
\[
f_1=\frac{\Sexpr{v}}{2\cdot\Sexpr{L}}=\Sexpr{fmt(f1)}\,\mathrm{Hz},
\]
e
\[
f_2=2f_1=\Sexpr{fmt(f2)}\,\mathrm{Hz}.
\]

\begin{answerlist}
  \item $\Sexpr{fmt(f1)}\,\mathrm{Hz}$;
  \item $\Sexpr{fmt(f2)}\,\mathrm{Hz}$.
\end{answerlist}

\end{solution}

