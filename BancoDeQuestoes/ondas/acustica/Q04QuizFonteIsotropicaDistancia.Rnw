<<echo=FALSE, results=hide>>=
fator <- sample(c(2,3,4),1)
correta <- paste0("A intensidade passa a ser ", fator^2, " vezes menor.")
alternativas <- c(
  correta,
  paste0("A intensidade passa a ser ", fator, " vezes menor."),
  paste0("A intensidade passa a ser ", fator, " vezes maior."),
  "A intensidade permanece a mesma.",
  paste0("A intensidade passa a ser ", 2*fator, " vezes menor.")
)
solutions <- c(TRUE,FALSE,FALSE,FALSE,FALSE)
ord <- sample(seq_along(alternativas)); alternativas <- alternativas[ord]; solutions <- solutions[ord]
@
\usepackage[utf8]{inputenc}

\begin{question}

Uma pequena fonte sonora emite aproximadamente a mesma potência em todas as direções. Dois detectores estão sobre o mesmo raio, nas distâncias $r$ e $\Sexpr{fator}r$ da fonte, como esquematizado.

<<fig=TRUE, height=3.6, width=6.0, echo=FALSE, eps=FALSE, results=hide>>=
par(mar=c(0.8,0.8,0.8,0.8),asp=1)
plot(0,0,type="n",axes=FALSE,xlab="",ylab="",xlim=c(-1.2,4.8),ylim=c(-2.2,2.2))
for(rr in c(1,2,3,4)) symbols(0,0,circles=rr,inches=FALSE,add=TRUE)
points(0,0,pch=19,cex=1.2); text(0,0.25,"S",font=2)
points(1,0,pch=17,cex=1.1); text(1,-0.28,"D1")
points(fator,0,pch=17,cex=1.1); text(fator,-0.28,"D2")
arrows(0,0.55,1,0.55,length=0.07); text(0.5,0.78,"r")
arrows(0,1.1,fator,1.1,length=0.07); text(fator/2,1.35,paste0(fator,"r"))
@

Desprezando absorção pelo ar, como a intensidade medida pelo detector mais distante se compara à intensidade medida em $r$?

<<echo=FALSE, results=tex>>=
answerlist(alternativas)
@

\end{question}

\begin{solution}

Para uma fonte pontual isotrópica,
\[
I=\frac{P}{4\pi r^2}.
\]
Se a distância é multiplicada por $\Sexpr{fator}$, a intensidade é dividida por $\Sexpr{fator}^2=\Sexpr{fator^2}$.

<<echo=FALSE, results=tex>>=
answerlist(ifelse(solutions,paste0('\\textbf{',alternativas,'}'),alternativas))
@

\end{solution}

