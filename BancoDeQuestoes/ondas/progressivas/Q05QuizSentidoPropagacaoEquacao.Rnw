<<echo=FALSE, results=hide>>=
dir <- sample(c(1,-1),1)
sinal <- ifelse(dir==1,"-","+")
correta <- ifelse(dir==1,"sentido positivo do eixo x","sentido negativo do eixo x")
alternativas <- c(
  correta,
  ifelse(dir==1,"sentido negativo do eixo x","sentido positivo do eixo x"),
  "sentido positivo do eixo y",
  "sentido negativo do eixo y",
  "a função não representa uma onda progressiva"
)
solutions <- c(TRUE,FALSE,FALSE,FALSE,FALSE)
ord <- sample(seq_along(alternativas))
alternativas <- alternativas[ord]
solutions <- solutions[ord]
@
\usepackage[utf8]{inputenc}

\begin{question}

Uma onda transversal é descrita por
\[
y(x,t)=0{,}03\,\sen(4x\Sexpr{sinal}10t),
\]
com as grandezas expressas no SI.

Em que sentido a forma de onda se propaga?

<<echo=FALSE, results=tex>>=
answerlist(alternativas)
@

\end{question}

\begin{solution}

Uma onda escrita na forma $y(x,t)=y_m\sen(kx-\omega t)$ se propaga no sentido positivo de $x$. Quando o sinal entre os termos é positivo, $kx+\omega t$, a propagação ocorre no sentido negativo de $x$.

Nesta questão, o sinal é $\Sexpr{sinal}$; portanto, a onda se propaga no \Sexpr{correta}.

<<echo=FALSE, results=tex>>=
answerlist(ifelse(solutions,paste0('\\textbf{',alternativas,'}'),alternativas))
@

\end{solution}

