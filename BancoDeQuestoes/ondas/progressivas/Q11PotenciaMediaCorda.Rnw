<<echo=FALSE, results=hide>>=
mu_g <- sample(c(5,10,20),1)
mu <- mu_g/1000
FT <- sample(c(40,100,160),1)
f <- sample(c(10,20,30),1)
A_mm <- sample(c(2,3,4,5),1)
A <- A_mm/1000
v <- sqrt(FT/mu)
omega <- 2*pi*f
P <- 0.5*mu*v*omega^2*A^2
fmt <- function(x,d=3) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}

Uma onda senoidal de frequência $\Sexpr{f}\,\mathrm{Hz}$ e amplitude $\Sexpr{A_mm}\,\mathrm{mm}$ se propaga em uma corda de massa específica linear $\Sexpr{mu_g}\,\mathrm{g/m}$ submetida a uma tração de $\Sexpr{FT}\,\mathrm{N}$.

Determine a potência média transportada pela onda, em watts. Use
\[
P_{\mathrm{méd}}=\frac12\mu v\omega^2 y_m^2.
\]

\end{question}

\begin{solution}

Convertendo para o SI,
\[
\mu=\Sexpr{fmt(mu,3)}\,\mathrm{kg/m},
\qquad
y_m=\Sexpr{fmt(A,3)}\,\mathrm{m}.
\]

A velocidade da onda é
\[
v=\sqrt{\frac{F_T}{\mu}}
=\sqrt{\frac{\Sexpr{FT}}{\Sexpr{fmt(mu,3)}}}
\approx\Sexpr{fmt(v,2)}\,\mathrm{m/s}.
\]

A frequência angular vale
\[
\omega=2\pi f=2\pi\cdot\Sexpr{f}
\approx\Sexpr{fmt(omega,2)}\,\mathrm{rad/s}.
\]

Portanto,
\[
P_{\mathrm{méd}}
=\frac12\mu v\omega^2 y_m^2
\approx\Sexpr{fmt(P,3)}\,\mathrm{W}.
\]

\end{solution}

