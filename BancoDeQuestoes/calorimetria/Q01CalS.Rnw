<<echo=FALSE, results=hide>>=
#Programado por: Marcelo C.

dta <- sample(seq(from=2,to=40,by=2),1)
mb <- sample(seq(from=10,to=200,by=10),1)
dtc <- sample(seq(from=2,to=40,by=1),1)
mc <- sample(seq(from=10,to=200,by=10),1)
tdf <- sample(seq(from=38,to=0,by=-1),1)

respa <- 0.1*dta
respb <- mb*0.1
respc <- mc*0.1*dtc
respd <- 20*0.1*(40-tdf)
@
\usepackage[utf8]{inputenc}

\begin{question}

O calor específico do zinco é aproximadamente igual a $0,1$ cal/g°C. Determine:

\begin{answerlist}

  \item A quantidade de calor absorvida (em calorias) por uma massa de 1 g de zinco que eleva sua temperatura em $\Sexpr{dta}$ °C
  
  \item A quantidade de calor absorvida (em calorias) por uma massa de $\Sexpr{mb}$ g de zinco se sua temperatura se elevar em 1 °C

  \item A quantidade de calor cedida ao meio ambiente (em calorias) por uma massa de $\Sexpr{mc}$ g de zinco se sua temperatura diminuir em $\Sexpr{dtc}$ °C
  
  \item A quantidade de calor cedida ao meio ambiente (em calorias) por uma massa de 20 g de zinco se sua temperatura diminuir de 40 °C para $\Sexpr{tdf}$ °C

\end{answerlist}

\end{question}

%% SOLUTION
\begin{solution}
Para calor sensível, usamos
\[
  Q=mc\Delta T,
\]
com \(c=0{,}1\,\mathrm{cal/(g\,^{\circ}C)}\).

\begin{answerlist}
  \item Para \(m=1\,\mathrm{g}\) e \(\Delta T=\Sexpr{dta}\,^{\circ}\mathrm{C}\),
  \[
    Q=1\cdot0{,}1\cdot\Sexpr{dta}
     =\Sexpr{respa}\,\mathrm{cal}.
  \]

  \item Para \(m=\Sexpr{mb}\,\mathrm{g}\) e \(\Delta T=1\,^{\circ}\mathrm{C}\),
  \[
    Q=\Sexpr{mb}\cdot0{,}1\cdot1
     =\Sexpr{respb}\,\mathrm{cal}.
  \]

  \item Como a temperatura diminui, o zinco cede calor. O módulo é
  \[
    |Q|=\Sexpr{mc}\cdot0{,}1\cdot\Sexpr{dtc}
       =\Sexpr{respc}\,\mathrm{cal}.
  \]

  \item A variação de temperatura, em módulo, é
  \[
    |\Delta T|=40-\Sexpr{tdf}.
  \]
  Portanto,
  \[
    |Q|=20\cdot0{,}1\,(40-\Sexpr{tdf})
       =\Sexpr{respd}\,\mathrm{cal}.
  \]
\end{answerlist}

\end{solution}

