<<echo=FALSE, results=hide>>=
  #Programado por: Jmduly
  
  pot1  <- sample(seq(from=200,to=1000,by=1),1)
  
  time1 <- sample(seq(from=1,to=5,by=1),1)
  
  temp1 <- sample(seq(from=20,to=40,by=1),1)
  
  temp2 <- sample(seq(from=60,to=90,by=1),1)
  
  resp1 <- round((pot1*time1*60)/(temp2-temp1), digits = 1)
  
@
  
\usepackage[utf8]{inputenc}
  
\begin{question}
  
Uma fonte calorífica fornece calor continuamente, à razão de $\Sexpr{pot1}$ cal/s, a uma determinada massa de água. Se a temperatura da água aumenta de $\Sexpr{temp1}$ ºC para $\Sexpr{temp2}$ ºC em $\Sexpr{time1}$ minutos, sendo o calor especifico sensível da água 1,0 cal/gºC. Determine a massa de água aquecida em gramas.

\end{question}
  
%% SOLUTION
\begin{solution}
A fonte fornece energia à taxa de \(\Sexpr{pot1}\,\mathrm{cal/s}\). Em \(\Sexpr{time1}\,\mathrm{min}=\Sexpr{time1*60}\,\mathrm{s}\),
\[
  Q=\Sexpr{pot1}\cdot\Sexpr{time1*60}
   =\Sexpr{pot1*time1*60}\,\mathrm{cal}.
\]

A variação de temperatura da água é
\[
  \Delta T=\Sexpr{temp2}-\Sexpr{temp1}
          =\Sexpr{temp2-temp1}\,^{\circ}\mathrm{C}.
\]

Como \(Q=mc\Delta T\) e \(c=1\,\mathrm{cal/(g\,^{\circ}C)}\),
\[
  m=\frac{Q}{c\Delta T}
   =\frac{\Sexpr{pot1*time1*60}}
          {1\cdot\Sexpr{temp2-temp1}}
   =\Sexpr{resp1}\,\mathrm{g}.
\]

\end{solution}
  
