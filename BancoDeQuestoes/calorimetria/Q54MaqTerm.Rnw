<<echo=FALSE, results=hide>>=
  #Programado por: Jmduly
  
  q1     <- sample(seq(from=100,to=150,by=1),1)
  
  q2     <- sample(seq(from=40,to=70,by=1),1)
  
  resp1  <- round((1- q2/q1), digits = 2)
    
@
  
\usepackage[utf8]{inputenc}
  
\begin{question}
  
Uma máquina térmica recebe de uma fonte quente $\Sexpr{q1}$ cal e transfere para uma fonte fria $\Sexpr{q2}$ cal. Qual o rendimento desta máquina, em forma decimal? Dê a resposta com duas casas decimais.

\end{question}
  
%% SOLUTION
\begin{solution}
A máquina recebe
\[
  Q_q=\Sexpr{q1}\,\mathrm{cal}
\]
da fonte quente e rejeita
\[
  Q_f=\Sexpr{q2}\,\mathrm{cal}
\]
para a fonte fria.

O trabalho útil em cada ciclo é
\[
  W=Q_q-Q_f
   =\Sexpr{q1-q2}\,\mathrm{cal}.
\]

O rendimento vale
\[
  \eta=\frac{W}{Q_q}
      =1-\frac{Q_f}{Q_q}
      =1-\frac{\Sexpr{q2}}{\Sexpr{q1}}
      =\Sexpr{resp1}.
\]

Isso corresponde a aproximadamente
\(\Sexpr{round(100*resp1,0)}\%\).

\end{solution}
  
