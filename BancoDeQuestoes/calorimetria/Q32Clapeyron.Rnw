<<echo=FALSE, results=hide>>=
  #Marcelo C.

vol  <- sample(seq(from=7,to=12,by=0.1),1)
m1  <- sample(seq(from=200,to=300,by=5),1)
temp1 <- sample(seq(from=20,to=40,by=1),1)
p2 <- sample(seq(from=2,to=5,by=0.1),1)
p1_exact <- m1*0.082*(temp1+273)/(32*vol)
p1 <- round(p1_exact, digits = 2)
m2 <- round(m1-p2*m1/p1_exact, digits = 2)

@
  
\usepackage[utf8]{inputenc}
  
\begin{question}
  
(PUC-adapt.) Um cilindro de $\Sexpr{vol}$ L de capacidade contém $\Sexpr{m1}$ g de gás oxigênio a $\Sexpr{temp1}$ °C. Um estudante abre a válvula do cilindro deixando escapar o gás até que a pressão seja reduzida para $\Sexpr{p2}$ atm. Supondo-se que a temperatura permaneça constante, determine: (massa molar do $O_2 = 32$ g/mol; $R = 0,082$ atm.L/mol.K)

\begin{answerlist}

  \item A pressão inicial no cilindro, em atm. \textit{Resposta com duas casas decimais}
  \item A massa de gás liberada, em gramas. \textit{Resposta com duas casas decimais.}

\end{answerlist}

\end{question}
  
%% SOLUTION
\begin{solution}
\begin{answerlist}
  \item A quantidade de matéria inicial é
  \[
    n=\frac{m}{M}
     =\frac{\Sexpr{m1}}{32}\,\mathrm{mol}.
  \]
  Pela equação de Clapeyron,
  \[
    p_1V=nRT.
  \]
  Logo,
  \[
    p_1=
    \frac{(\Sexpr{m1}/32)\,0{,}082\,(\Sexpr{temp1}+273)}
         {\Sexpr{vol}}
    =\Sexpr{p1}\,\mathrm{atm}.
  \]

  \item Como \(V\) e \(T\) permanecem constantes, a pressão é proporcional ao número de mols e, portanto, à massa do gás:
  \[
    \frac{p_2}{p_1}=\frac{m_{\mathrm{restante}}}{m_1}.
  \]
  Assim,
  \[
    m_{\mathrm{restante}}
    =\Sexpr{m1}\frac{\Sexpr{p2}}{\Sexpr{round(p1_exact,2)}}.
  \]
  A massa liberada é
  \[
    m_{\mathrm{lib}}
    =m_1-m_{\mathrm{restante}}
    =\Sexpr{m2}\,\mathrm{g}.
  \]
\end{answerlist}

\end{solution}
  
