<<echo=FALSE, results=hide>>=
g<-10; v0<-sample(c(30,40,50,60,80),1); sen<-0.6; cos<-0.8
vx<-v0*cos; vy<-v0*sen; ts<-vy/g; H<-vy^2/(2*g); T<-2*ts; vyf<- -vy; A<-vx*T
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("eq_q11_vetor.jpg", dir="../../../../figuras")
@
\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Um corpo é lançado obliquamente com velocidade inicial $\Sexpr{fmt(v0,0)}\,\mathrm{m/s}$ a $37^\circ$ da horizontal. Use $\sin37^\circ=0{,}6$, $\cos37^\circ=0{,}8$, $g=10\,\mathrm{m/s^2}$ e despreze a resistência do ar. Determine:
\begin{answerlist}
\item $v_{0x}$ e $v_{0y}$, em $\mathrm{m/s}$;
\item tempo de subida e altura máxima;
\item velocidade escalar no ápice;
\item tempo total de voo;
\item componente vertical da velocidade ao atingir o solo;
\item alcance horizontal.
\end{answerlist}
\end{question}
\begin{solution}
$v_{0x}=\Sexpr{fmt(vx)}$, $v_{0y}=\Sexpr{fmt(vy)}$, $t_s=\Sexpr{fmt(ts)}$, $H=\Sexpr{fmt(H)}$, $v_{apice}=\Sexpr{fmt(vx)}$, $T=\Sexpr{fmt(T)}$, $v_{yf}=\Sexpr{fmt(vyf)}$ e $A=\Sexpr{fmt(A)}$.
\begin{answerlist}
  \item $\Sexpr{fmt(vx)}$ e $\Sexpr{fmt(vy)}$
  \item $\Sexpr{fmt(ts)}$ e $\Sexpr{fmt(H)}$
  \item $\Sexpr{fmt(vx)}$
  \item $\Sexpr{fmt(T)}$
  \item $\Sexpr{fmt(vyf)}$
  \item $\Sexpr{fmt(A)}$
\end{answerlist}
\end{solution}

