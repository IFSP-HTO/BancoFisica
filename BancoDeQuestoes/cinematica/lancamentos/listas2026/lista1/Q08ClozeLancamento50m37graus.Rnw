img_b64 <- ""
img_file <- "eq_q11_vetor.jpg"
writeBin(base64enc::base64decode(img_b64), img_file)
@
\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Um corpo é lançado do solo com velocidade inicial \(50\,\mathrm{m/s}\), formando \(37^\circ\) com a horizontal. Use \(\sin37^\circ=0{,}6\), \(\cos37^\circ=0{,}8\), \(g=10\,\mathrm{m/s^2}\) e despreze a resistência do ar.

\begin{center}
\includegraphics[width=5cm,keepaspectratio]{eq_q11_vetor.jpg}
\end{center}
\begin{answerlist}
  \item \(v_{0x}\), em \(\mathrm{m/s}\);
  \item \(v_{0y}\), em \(\mathrm{m/s}\);
  \item tempo de subida, em \(\mathrm{s}\);
  \item altura máxima, em \(\mathrm{m}\);
  \item velocidade escalar no ápice, em \(\mathrm{m/s}\);
  \item tempo total de voo, em \(\mathrm{s}\);
  \item componente vertical da velocidade ao retornar ao solo, em \(\mathrm{m/s}\);
  \item alcance, em \(\mathrm{m}\).
\end{answerlist}
\end{question}

\begin{solution}
Temos \(v_{0x}=50(0{,}8)=40\) e \(v_{0y}=50(0{,}6)=30\,\mathrm{m/s}\). Assim \(t_s=3\,\mathrm{s}\), \(H=30^2/(2\cdot10)=45\,\mathrm{m}\), \(v_{\rm ápice}=40\,\mathrm{m/s}\), \(T=6\,\mathrm{s}\), \(v_y(T)=-30\,\mathrm{m/s}\) e \(A=40(6)=240\,\mathrm{m}\).

\begin{answerlist}
  \item \(v_{0x}\), em \(\mathrm{m/s}\);
  \item \(v_{0y}\), em \(\mathrm{m/s}\);
  \item tempo de subida, em \(\mathrm{s}\);
  \item altura máxima, em \(\mathrm{m}\);
  \item velocidade escalar no ápice, em \(\mathrm{m/s}\);
  \item tempo total de voo, em \(\mathrm{s}\);
  \item componente vertical da velocidade ao retornar ao solo, em \(\mathrm{m/s}\);
  \item alcance, em \(\mathrm{m}\).
\end{answerlist}
\end{solution}

