<<echo=FALSE, results=hide>>=
g<-10; v0<-sample(c(10,20,30,40),1); sen<-0.8; cos<-0.6
vx<-v0*cos; vy<-v0*sen; H<-vy^2/(2*g); T<-2*vy/g; A<-vx*T
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Um projétil é lançado do solo com velocidade $\Sexpr{fmt(v0,0)}\,\mathrm{m/s}$, formando um ângulo $\alpha$ tal que $\sin\alpha=0{,}8$ e $\cos\alpha=0{,}6$. Adote $g=10\,\mathrm{m/s^2}$. Determine:
\begin{answerlist}
  \item altura máxima, em $\mathrm{m}$;
  \item alcance horizontal, em $\mathrm{m}$.
\end{answerlist}
\end{question}
\begin{solution}
Decompomos a velocidade inicial nas direções horizontal e vertical:
\[
  v_{0x}=v_0\cos\alpha=\Sexpr{fmt(v0,0)}\cdot0{,}6=\Sexpr{fmt(vx)}\,\mathrm{m/s},
\]
\[
  v_{0y}=v_0\sin\alpha=\Sexpr{fmt(v0,0)}\cdot0{,}8=\Sexpr{fmt(vy)}\,\mathrm{m/s}.
\]

No ponto mais alto, a velocidade vertical é nula. Assim,
\[
  H=\frac{v_{0y}^2}{2g}
   =\frac{\Sexpr{fmt(vy)}^2}{20}
   =\Sexpr{fmt(H)}\,\mathrm{m}.
\]
O tempo total de voo é
\[
  T=\frac{2v_{0y}}{g}=\Sexpr{fmt(T)}\,\mathrm{s}.
\]
Logo, o alcance horizontal é
\[
  A=v_{0x}T
   =\Sexpr{fmt(vx)}\cdot\Sexpr{fmt(T)}
   =\Sexpr{fmt(A)}\,\mathrm{m}.
\]

\begin{answerlist}
  \item \Sexpr{fmt(H)}
  \item \Sexpr{fmt(A)}
\end{answerlist}

\end{solution}

