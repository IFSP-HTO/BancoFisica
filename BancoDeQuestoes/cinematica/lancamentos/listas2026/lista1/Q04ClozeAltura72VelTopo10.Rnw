<<echo=FALSE, results=hide>>=
g <- 10
configs <- data.frame(vx=c(6,8,10,12,15), vy=c(8,10,12,15,20))
i <- sample(seq_len(nrow(configs)),1); vx<-configs$vx[i]; vy<-configs$vy[i]
H <- vy^2/(2*g); ts<-vy/g; T<-2*ts; A<-vx*T
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Um projétil é lançado obliquamente e atinge altura máxima de $\Sexpr{fmt(H,2)}\,\mathrm{m}$. No ponto mais alto da trajetória, sua velocidade escalar é $\Sexpr{fmt(vx,1)}\,\mathrm{m/s}$. Adote $g=10\,\mathrm{m/s^2}$ e suponha que o projétil retorna ao mesmo nível em que foi lançado. Determine:
\begin{answerlist}
\item tempo de subida, em $\mathrm{s}$;
\item tempo total, em $\mathrm{s}$;
\item alcance horizontal, em $\mathrm{m}$.
\end{answerlist}
\end{question}
\begin{solution}
No ápice, $v_y=0$ e a velocidade escalar é $v_x$. Da altura máxima, $v_{0y}=\sqrt{2gH}=\Sexpr{fmt(vy,1)}$. Logo $t_s=\Sexpr{fmt(ts,2)}$, $T=\Sexpr{fmt(T,2)}$ e $A=v_xT=\Sexpr{fmt(A,2)}$.
\begin{answerlist}
  \item $\Sexpr{fmt(ts,2)}$
  \item $\Sexpr{fmt(T,2)}$
  \item $\Sexpr{fmt(A,2)}$
\end{answerlist}
\end{solution}

