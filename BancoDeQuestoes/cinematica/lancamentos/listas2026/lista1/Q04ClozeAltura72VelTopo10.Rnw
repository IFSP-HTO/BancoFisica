\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Um projétil é lançado obliquamente e atinge altura máxima de \(7{,}2\,\mathrm{m}\). No ponto mais alto da trajetória, sua velocidade escalar é \(10\,\mathrm{m/s}\). Adote \(g=10\,\mathrm{m/s^2}\) e suponha que o projétil retorna ao mesmo nível em que foi lançado.

\begin{answerlist}
  \item tempo de subida, em \(\mathrm{s}\);
  \item tempo total de voo, em \(\mathrm{s}\);
  \item alcance horizontal, em \(\mathrm{m}\).
\end{answerlist}
\end{question}

\begin{solution}
No ápice, \(v_y=0\) e a velocidade de \(10\,\mathrm{m/s}\) é a componente horizontal. Pela altura máxima, \(v_{0y}=\sqrt{2gH}=\sqrt{144}=12\,\mathrm{m/s}\). Logo \(t_s=1{,}2\,\mathrm{s}\), \(T=2{,}4\,\mathrm{s}\) e \(A=10(2{,}4)=24\,\mathrm{m}\).

\begin{answerlist}
  \item tempo de subida, em \(\mathrm{s}\);
  \item tempo total de voo, em \(\mathrm{s}\);
  \item alcance horizontal, em \(\mathrm{m}\).
\end{answerlist}
\end{solution}

