<<echo=FALSE, results=hide>>=
g <- 10
v0 <- sample(c(10, 20, 30, 40), 1)
sen <- 0.5
H <- (v0*sen)^2/(2*g)
opts <- c(v0, 0.5*v0, 0.75*v0, 1.25*v0, 1.5*v0)
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Um jogador de futebol chuta uma bola com velocidade inicial que faz $30^\circ$ com a horizontal. Desprezando a resistência do ar, qual valor representa o módulo da velocidade inicial para que a bola atinja uma altura máxima de $\Sexpr{fmt(H,2)}\,\mathrm{m}$ em relação ao ponto de lançamento? Adote $g=10\,\mathrm{m/s^2}$ e $\sin30^\circ=0{,}50$.
\begin{answerlist}
\item $\Sexpr{fmt(opts[1],1)}\,\mathrm{m/s}$
\item $\Sexpr{fmt(opts[2],1)}\,\mathrm{m/s}$
\item $\Sexpr{fmt(opts[3],1)}\,\mathrm{m/s}$
\item $\Sexpr{fmt(opts[4],1)}\,\mathrm{m/s}$
\item $\Sexpr{fmt(opts[5],1)}\,\mathrm{m/s}$
\end{answerlist}
\end{question}
\begin{solution}
No ponto mais alto, $v_y=0$. Assim, $H=v_{0y}^2/(2g)$ e $v_{0y}=v_0\sin30^\circ$. Logo, $v_0=\Sexpr{fmt(v0,1)}\,\mathrm{m/s}$.
\begin{answerlist}
  \item correta
  \item incorreta
  \item incorreta
  \item incorreta
  \item incorreta
\end{answerlist}
\end{solution}

