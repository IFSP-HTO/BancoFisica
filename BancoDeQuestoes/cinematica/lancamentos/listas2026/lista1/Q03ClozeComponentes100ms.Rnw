<<echo=FALSE, results=hide>>=
g <- 10
v0 <- sample(c(40,50,60,80,100),1)
sen <- 0.8; cos <- 0.6
vx <- v0*cos; vy <- v0*sen
ts <- vy/g; H <- vy^2/(2*g); T <- 2*ts; A <- vx*T
fmt <- function(x,d=1) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Um corpo é lançado obliquamente no vácuo com velocidade inicial $V_0=\Sexpr{fmt(v0,0)}\,\mathrm{m/s}$, em uma direção para a qual $\sin\theta=0{,}8$ e $\cos\theta=0{,}6$. Adote $g=10\,\mathrm{m/s^2}$ e despreze a resistência do ar. Determine:
\begin{answerlist}
\item $v_{0x}$, em $\mathrm{m/s}$;
\item $v_{0y}$, em $\mathrm{m/s}$;
\item tempo de subida, em $\mathrm{s}$;
\item altura máxima, em $\mathrm{m}$;
\item alcance, em $\mathrm{m}$.
\end{answerlist}
\end{question}
\begin{solution}
$v_{0x}=V_0\cos\theta=\Sexpr{fmt(vx)}$, $v_{0y}=V_0\sin\theta=\Sexpr{fmt(vy)}$. Então $t_s=v_{0y}/g=\Sexpr{fmt(ts)}$, $H=v_{0y}^2/(2g)=\Sexpr{fmt(H)}$ e $A=v_{0x}(2t_s)=\Sexpr{fmt(A)}$.
\begin{answerlist}
\item $\Sexpr{fmt(vx)}$\item $\Sexpr{fmt(vy)}$\item $\Sexpr{fmt(ts)}$\item $\Sexpr{fmt(H)}$\item $\Sexpr{fmt(A)}$
\end{answerlist}
\end{solution}

