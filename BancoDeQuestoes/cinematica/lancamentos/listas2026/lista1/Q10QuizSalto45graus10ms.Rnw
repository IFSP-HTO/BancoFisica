\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Um atleta realiza um salto com velocidade inicial de \(10\,\mathrm{m/s}\), formando \(45^\circ\) com a horizontal. Considerando lançamento e queda no mesmo nível, desprezando o ar e adotando \(g=10\,\mathrm{m/s^2}\), qual é o alcance?

\begin{answerlist}
  \item \(2\,\mathrm{m}\)
  \item \(4\,\mathrm{m}\)
  \item \(6\,\mathrm{m}\)
  \item \(8\,\mathrm{m}\)
  \item \(10\,\mathrm{m}\)
\end{answerlist}
\end{question}

\begin{solution}
Para \(\theta=45^\circ\), \(A=v_0^2\sin90^\circ/g=100/10=10\,\mathrm{m}\).

\begin{answerlist}
  \item \(2\,\mathrm{m}\)
  \item \(4\,\mathrm{m}\)
  \item \(6\,\mathrm{m}\)
  \item \(8\,\mathrm{m}\)
  \item \(10\,\mathrm{m}\)
\end{answerlist}
\end{solution}

