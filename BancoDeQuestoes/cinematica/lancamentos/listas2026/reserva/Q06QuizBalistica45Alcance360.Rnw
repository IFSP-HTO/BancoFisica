<<echo=FALSE, results=hide>>=
g<-10; v0<-sample(c(20,30,40,50,60),1); A<-v0^2/g; opts<-c(v0,0.5*v0,0.75*v0,1.25*v0,1.5*v0); fmt<-function(x,d=1) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Num teste de balística, um projétil é lançado do solo a $45^\circ$ e retorna ao solo $\Sexpr{fmt(A,0)}\,\mathrm{m}$ adiante. Adote $g=10\,\mathrm{m/s^2}$. Qual é a velocidade de lançamento?
\begin{answerlist}
  \item $\Sexpr{fmt(opts[1])}\,\mathrm{m/s}$
  \item $\Sexpr{fmt(opts[2])}\,\mathrm{m/s}$
  \item $\Sexpr{fmt(opts[3])}\,\mathrm{m/s}$
  \item $\Sexpr{fmt(opts[4])}\,\mathrm{m/s}$
  \item $\Sexpr{fmt(opts[5])}\,\mathrm{m/s}$
\end{answerlist}
\end{question}
\begin{solution}
Para $45^\circ$, $A=v_0^2/g$, portanto $v_0=\Sexpr{fmt(v0)}\,\mathrm{m/s}$.
\begin{answerlist}
  \item correta
  \item incorreta
  \item incorreta
  \item incorreta
  \item incorreta
\end{answerlist}
\end{solution}

