<<echo=FALSE, results=hide>>=
g<-10; sen<-0.5; cos<-0.87; ts<-sample(c(0.4,0.5,0.6,0.8,1.0),1); vy<-g*ts; v0<-vy/sen; x<-v0*cos*ts
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Um jogador de basquete arremessa uma bola com velocidade inicial formando $30^\circ$ com a horizontal. Após $\Sexpr{fmt(ts,1)}\,\mathrm{s}$, a bola atinge a altura máxima. Considere $g=10\,\mathrm{m/s^2}$, $\sin30^\circ=0{,}50$ e $\cos30^\circ=0{,}87$. Suponha que a cesta esteja na vertical do ponto de altura máxima. Determine:
\begin{answerlist}
  \item velocidade inicial, em $\mathrm{m/s}$;
  \item distância horizontal até a cesta, em $\mathrm{m}$.
\end{answerlist}
\end{question}
\begin{solution}
$v_{0y}=gt_s=\Sexpr{fmt(vy)}$, então $v_0=v_{0y}/0{,}5=\Sexpr{fmt(v0)}$. A distância é $x=v_0\cos30^\circ t_s=\Sexpr{fmt(x)}$.
\begin{answerlist}
  \item $\Sexpr{fmt(v0)}$
  \item $\Sexpr{fmt(x)}$
\end{answerlist}
\end{solution}

