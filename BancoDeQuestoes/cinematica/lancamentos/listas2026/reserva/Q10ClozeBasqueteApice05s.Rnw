\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Um jogador de basquete arremessa uma bola com velocidade inicial formando \(30^\circ\) com a horizontal. Após \(0{,}5\,\mathrm{s}\), a bola atinge a altura máxima. Considere \(g=10\,\mathrm{m/s^2}\), \(\sin30^\circ=0{,}50\) e \(\cos30^\circ=0{,}87\). Suponha que a cesta esteja na vertical do ponto de altura máxima, como indicado na figura original.

\begin{answerlist}
  \item módulo da velocidade inicial, em \(\mathrm{m/s}\);
  \item distância horizontal até a vertical da cesta, em \(\mathrm{m}\).
\end{answerlist}
\end{question}

\begin{solution}
No ápice, \(v_y=0\), então \(v_{0y}=gt_s=10(0{,}5)=5\,\mathrm{m/s}\). Como \(v_{0y}=v_0\sin30^\circ\), resulta \(v_0=10\,\mathrm{m/s}\). A componente horizontal é \(v_x=10(0{,}87)=8{,}7\,\mathrm{m/s}\), e em \(0{,}5\,\mathrm{s}\) percorre \(x=4{,}35\,\mathrm{m}\).

\begin{answerlist}
  \item módulo da velocidade inicial, em \(\mathrm{m/s}\);
  \item distância horizontal até a vertical da cesta, em \(\mathrm{m}\).
\end{answerlist}
\end{solution}

