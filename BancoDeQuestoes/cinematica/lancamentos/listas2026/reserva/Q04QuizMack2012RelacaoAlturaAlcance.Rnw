ratios <- c(0.07,0.15,0.25,0.30,0.93)
angles <- c(15,30,45,50,75)
tan_table <- c(0.27,0.58,1.00,1.20,3.70)
i <- sample(seq_along(ratios),1)
k <- ratios[i]
tan_est <- 4*k
solutions <- rep(FALSE,5); solutions[i] <- TRUE
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("LO26_MACK2012_altura_alcance_base.png", dir="../../../../figuras")
base_path <- "LO26_MACK2012_altura_alcance_base.png"
render_overlay_png <- function(source, outfile, overlays) {
img <- png::readPNG(source)
  h <- dim(img)[1]
  w <- dim(img)[2]
  grDevices::png(outfile, width=w, height=h, bg="white")
  grid::grid.newpage()
  grid::grid.raster(img, width=grid::unit(1,"npc"), height=grid::unit(1,"npc"), interpolate=FALSE)
  for (o in overlays) {
    grid::grid.rect(
      x=grid::unit((o$x1+o$x2)/(2*w),"npc"),
      y=grid::unit(1-(o$y1+o$y2)/(2*h),"npc"),
      width=grid::unit((o$x2-o$x1)/w,"npc"),
      height=grid::unit((o$y2-o$y1)/h,"npc"),
      gp=grid::gpar(fill="white", col=NA)
    )
    rot <- if (is.null(o$rot)) 0 else o$rot
    fontsize <- if (is.null(o$fontsize)) 12 else o$fontsize
    just <- if (is.null(o$just)) c("left","top") else o$just
    grid::grid.text(
      o$text,
      x=grid::unit(o$x/w,"npc"), y=grid::unit(1-o$y/h,"npc"),
      just=just, rot=rot,
      gp=grid::gpar(col="black", fontsize=fontsize, fontfamily="serif")
    )
  }
  grDevices::dev.off()
  invisible(outfile)
}
img <- "Q04_MACK.png"
render_overlay_png(base_path, img, list(
  list(x1=133,y1=34,x2=226,y2=72,text=paste0(fmt(k,2)," x"),x=145,y=41,fontsize=13)
))
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
Uma bola é lançada do solo e retorna ao mesmo nível. A figura informa que a altura máxima é $\Sexpr{fmt(k)}$ vezes o alcance horizontal $x$. Despreze a resistência do ar. Usando a tabela fornecida na própria figura, qual é aproximadamente o ângulo $\alpha$ de lançamento?
\begin{center}\includegraphics[width=7cm,keepaspectratio]{\Sexpr{img}}\end{center}
\begin{answerlist}
  \item $15^\circ$
  \item $30^\circ$
  \item $45^\circ$
  \item $50^\circ$
  \item $75^\circ$
\end{answerlist}
\end{question}
\begin{solution}
Para lançamento e queda no mesmo nível, $H/A=\tan\alpha/4$. Assim, $\tan\alpha\approx4(\Sexpr{fmt(k)})=\Sexpr{fmt(tan_est)}$. O valor mais próximo na linha da tangente da tabela corresponde a $\Sexpr{angles[i]}^\circ$.
\begin{answerlist}
  \item $15^\circ$
  \item $30^\circ$
  \item $45^\circ$
  \item $50^\circ$
  \item $75^\circ$
\end{answerlist}
\end{solution}
%% META-INFORMATION
%% Fonte: Mackenzie-SP 2012, reproduzida em "Balística - Avançada" (PDF fornecido).
%% Figura/tabela: recorte direto do PDF original; apenas a razão H/x é substituída programaticamente em cada variante.
