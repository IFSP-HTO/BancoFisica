<<echo=FALSE, results=hide>>=
g <- 10
theta <- 30
sen <- 0.5
cos <- 0.866
configs <- data.frame(v0=c(20,24,30,20,24), H2=c(80,72,60,90,84), teq=c(2.0,2.0,1.6,2.5,1.5))
i <- sample(seq_len(nrow(configs)),1)
v0<-configs$v0[i]; H2<-configs$H2[i]; teq<-configs$teq[i]
vy<-v0*sen; vx<-v0*cos
H1<-H2+vy*teq
Hmax<-H2+vy^2/(2*g)
tclaim<-teq+0.5
t2<-(vy+sqrt(vy^2+2*g*H2))/g
t1<-sqrt(2*H1/g)
threshold<-t2+0.5
dist<-vx*teq
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}
Do topo de uma plataforma de $\Sexpr{fmt(H1,1)}\,\mathrm{m}$, solta-se um corpo $C_1$. No mesmo instante, de um ponto a $\Sexpr{H2}\,\mathrm{m}$ do solo, lança-se $C_2$ com velocidade $\Sexpr{v0}\,\mathrm{m/s}$, a $30^\circ$ acima da horizontal. Os corpos estavam inicialmente na mesma vertical. Despreze o ar e adote $g=10\,\mathrm{m/s^2}$, $\sin30^\circ=0{,}5$ e $\cos30^\circ\approx0{,}866$. Assinale as afirmações corretas.
\begin{answerlist}
  \item A altura máxima de $C_2$, em relação ao solo, é $\Sexpr{fmt(Hmax)}\,\mathrm{m}$.
  \item Os corpos atingem a mesma altura $\Sexpr{fmt(tclaim)}\,\mathrm{s}$ após o lançamento.
  \item $C_2$ demora mais de $\Sexpr{fmt(threshold)}\,\mathrm{s}$ para atingir o solo.
  \item Os dois corpos atingem o solo no mesmo instante.
  \item A distância entre os corpos $\Sexpr{fmt(teq)}\,\mathrm{s}$ após o lançamento é $\Sexpr{fmt(dist)}\,\mathrm{m}$.
\end{answerlist}
\end{question}
\begin{solution}
Para $C_2$, $v_{0y}=\Sexpr{fmt(vy)}\,\mathrm{m/s}$ e $H_{max}=H_2+v_{0y}^2/(2g)=\Sexpr{fmt(Hmax)}\,\mathrm{m}$, logo a primeira é verdadeira. Igualando as alturas, os termos $-gt^2/2$ cancelam e resulta $t=(H_1-H_2)/v_{0y}=\Sexpr{fmt(teq)}\,\mathrm{s}$, portanto a segunda é falsa. O tempo de $C_2$ até o solo é $\Sexpr{fmt(t2)}\,\mathrm{s}$, menor que $\Sexpr{fmt(threshold)}\,\mathrm{s}$; $C_1$ chega em $\Sexpr{fmt(t1)}\,\mathrm{s}$, diferente. Em $t=\Sexpr{fmt(teq)}\,\mathrm{s}$ as alturas são iguais, de modo que a separação é horizontal: $d=v_x t=\Sexpr{fmt(dist)}\,\mathrm{m}$.
\begin{answerlist}
  \item correta
  \item incorreta
  \item incorreta
  \item incorreta
  \item correta
\end{answerlist}
\end{solution}

