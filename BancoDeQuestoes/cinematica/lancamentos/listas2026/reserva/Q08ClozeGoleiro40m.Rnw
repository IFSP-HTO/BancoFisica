<<echo=FALSE, results=hide>>=
g <- 10
configs <- data.frame(
  theta=c(25,25,30,30,37,37),
  xg=c(40,45,40,45,50,45),
  v0=c(26,28,26,28,26,30),
  sen=c(0.42,0.42,0.50,0.50,0.60,0.60),
  cos=c(0.91,0.91,0.866,0.866,0.80,0.80)
)
i <- sample(seq_len(nrow(configs)),1)
theta <- configs$theta[i]
xg <- configs$xg[i]
v0 <- configs$v0[i]
sen <- configs$sen[i]
cos <- configs$cos[i]
t <- xg/(v0*cos)
yg <- v0*sen*t - 0.5*g*t^2
yline <- 1.5
Aq <- -g/(2*(v0*cos)^2)
Bq <- sen/cos
Cq <- -yline
disc <- Bq^2 - 4*Aq*Cq
roots <- c((-Bq+sqrt(disc))/(2*Aq), (-Bq-sqrt(disc))/(2*Aq))
xline <- max(roots[roots>0])
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("LO26_Panosso26_goleiro_simbolica.png", dir="../../../../figuras")
img <- "LO26_Panosso26_goleiro_simbolica.png"
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
Uma bola é chutada com $v_0=\Sexpr{v0}\,\mathrm{m/s}$, a $\Sexpr{theta}^\circ$ da horizontal. O goleiro está a uma distância $D=\Sexpr{xg}\,\mathrm{m}$ do ponto do chute e alcança até $3{,}0\,\mathrm{m}$ de altura. Se a bola passar por ele, cruza a linha do gol a $1{,}5\,\mathrm{m}$ do chão. Use $g=10\,\mathrm{m/s^2}$, $\sin\Sexpr{theta}^\circ=\Sexpr{fmt(sen,4)}$ e $\cos\Sexpr{theta}^\circ=\Sexpr{fmt(cos,4)}$.
\begin{center}\includegraphics[width=9cm,keepaspectratio]{\Sexpr{img}}\end{center}
Determine:
\begin{answerlist}
  \item a altura da bola sobre o goleiro, em $\mathrm{m}$;
  \item a distância do chute até a linha do gol correspondente à passagem descendente por $1{,}5\,\mathrm{m}$, em $\mathrm{m}$.
\end{answerlist}
\end{question}

\begin{solution}
Em $x=D=\Sexpr{xg}\,\mathrm{m}$, $y=\Sexpr{fmt(yg)}\,\mathrm{m}$, portanto a bola passa acima dos $3{,}0\,\mathrm{m}$ alcançados pelo goleiro. Pela equação da trajetória, impondo $y=1{,}5\,\mathrm{m}$ e escolhendo a raiz descendente, $x=\Sexpr{fmt(xline)}\,\mathrm{m}$.
\begin{answerlist}
  \item $\Sexpr{fmt(yg)}$
  \item $\Sexpr{fmt(xline)}$
\end{answerlist}
\end{solution}

