<<echo=FALSE, results=hide>>=
g <- 10
configs <- data.frame(
  v0=c(40,45,50,55,60,65),
  H=c(45,60,50,70,80,65),
  theta=c(45,30,37,53,30,37),
  sen=c(0.7071,0.5000,0.6000,0.8000,0.5000,0.6000),
  cos=c(0.7071,0.8660,0.8000,0.6000,0.8660,0.8000)
)
i <- sample(seq_len(nrow(configs)),1)
v0 <- configs$v0[i]
H <- configs$H[i]
theta <- configs$theta[i]
sen <- configs$sen[i]
cos <- configs$cos[i]
vy0 <- v0*sen
vx <- v0*cos
t <- (vy0 + sqrt(vy0^2 + 2*g*H))/g
xR <- vx*t
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("LO26_UFOP2010_edificio_simbolica.png", dir="../../../../figuras")
img <- "LO26_UFOP2010_edificio_simbolica.png"
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
Uma pedra é lançada do alto de um edifício de $H=\Sexpr{H}\,\mathrm{m}$ com velocidade inicial $v_0=\Sexpr{v0}\,\mathrm{m/s}$, formando $\Sexpr{theta}^\circ$ com a horizontal. Adote $g=10\,\mathrm{m/s^2}$, $\sin\Sexpr{theta}^\circ=\Sexpr{fmt(sen,4)}$ e $\cos\Sexpr{theta}^\circ=\Sexpr{fmt(cos,4)}$. Determine o alcance horizontal $x_R$ até a pedra atingir o solo.
\begin{center}\includegraphics[width=7cm,keepaspectratio]{\Sexpr{img}}\end{center}
\begin{answerlist}
  \item $x_R$, em $\mathrm{m}$.
\end{answerlist}
\end{question}

\begin{solution}
Na vertical, $0=H+v_{0y}t-\frac12gt^2$, com $v_{0y}=\Sexpr{fmt(vy0)}\,\mathrm{m/s}$. A raiz positiva fornece $t=\Sexpr{fmt(t)}\,\mathrm{s}$. Como $v_x=\Sexpr{fmt(vx)}\,\mathrm{m/s}$,
\[
x_R=v_xt=\Sexpr{fmt(xR)}\,\mathrm{m}.
\]
\begin{answerlist}
  \item $\Sexpr{fmt(xR)}$
\end{answerlist}
\end{solution}

