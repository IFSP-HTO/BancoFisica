<<echo=FALSE, results=hide>>=
g<-10; v0<-sample(c(20,30,40,50),1); H<-v0^2/(4*g); A<-v0^2/g
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("pan_q27_debret.jpg", dir="../../../../figuras")
@
\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Inspirado na pintura "Caboclo", de Jean-Baptiste Debret, considere uma flecha lançada do nível do chão com velocidade $\Sexpr{fmt(v0,0)}\,\mathrm{m/s}$, formando $45^\circ$ com a horizontal. Despreze a resistência do ar e adote $g=10\,\mathrm{m/s^2}$.
\begin{center}\includegraphics[width=9cm,keepaspectratio]{pan_q27_debret.jpg}\end{center}
Determine:
\begin{answerlist}
  \item altura máxima, em $\mathrm{m}$;
  \item alcance, em $\mathrm{m}$.
\end{answerlist}
\end{question}
\begin{solution}
Para lançamento a \(45^\circ\), temos \(\sin45^\circ=\cos45^\circ=\sqrt{2}/2\).

A altura máxima pode ser escrita como
\[
  H=\frac{v_0^2\sin^2 45^\circ}{2g}
   =\frac{v_0^2}{4g}.
\]
Assim,
\[
  H=\frac{\Sexpr{fmt(v0,0)}^2}{40}
   =\Sexpr{fmt(H)}\,\mathrm{m}.
\]

O alcance para lançamento e queda no mesmo nível é
\[
  A=\frac{v_0^2\sin(2\theta)}{g}.
\]
Como \(2\theta=90^\circ\),
\[
  A=\frac{v_0^2}{g}
   =\frac{\Sexpr{fmt(v0,0)}^2}{10}
   =\Sexpr{fmt(A)}\,\mathrm{m}.
\]

\begin{answerlist}
  \item \Sexpr{fmt(H)}
  \item \Sexpr{fmt(A)}
\end{answerlist}

\end{solution}

