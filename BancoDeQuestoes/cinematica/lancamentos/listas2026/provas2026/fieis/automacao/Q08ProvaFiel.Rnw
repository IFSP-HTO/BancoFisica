\item B
\item C
\item D
\item E
\end{answerlist}
\end{question}
\begin{solution}
A alternativa correta é a letra \Sexpr{gabaritos[versao]}.
\begin{answerlist}
\item A
\item B
\item C
\item D
\item E
\end{answerlist}
\end{solution}
\exname{BF-LO26-AUTO-Q08}
\extype{schoice}
\exsolution{\Sexpr{sol}}
