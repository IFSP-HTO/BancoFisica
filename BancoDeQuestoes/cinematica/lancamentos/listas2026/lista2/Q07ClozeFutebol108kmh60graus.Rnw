\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Uma bola é chutada com velocidade \(108\,\mathrm{km/h}\), formando \(60^\circ\) com a horizontal. Despreze a resistência do ar e adote \(g=10\,\mathrm{m/s^2}\). Determine o alcance, considerando que a bola retorna ao nível de lançamento.

\begin{answerlist}
  \item alcance, em \(\mathrm{m}\).
\end{answerlist}
\end{question}

\begin{solution}
Primeiro, \(108\,\mathrm{km/h}=30\,\mathrm{m/s}\). Então \(A=v_0^2\sin(120^\circ)/g=900(0{,}866)/10\approx77{,}94\,\mathrm{m}\), equivalente a \(45\sqrt3\,\mathrm{m}\).

\begin{answerlist}
  \item alcance, em \(\mathrm{m}\).
\end{answerlist}
\end{solution}

