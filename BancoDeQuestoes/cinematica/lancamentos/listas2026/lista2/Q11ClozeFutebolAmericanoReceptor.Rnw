<<echo=FALSE, results=hide>>=
g <- 10
configs <- data.frame(
  theta=c(30,37,45,53,60),
  d0=c(10,12,15,18,20),
  sen=c(0.50,0.60,0.7071,0.80,0.866),
  cos=c(0.866,0.80,0.7071,0.60,0.50)
)
i <- sample(seq_len(nrow(configs)),1)
theta <- configs$theta[i]
d0 <- configs$d0[i]
sen <- configs$sen[i]
cos <- configs$cos[i]
v0 <- sample(c(20,25,30,35),1)
T <- 2*v0*sen/g
A <- v0*cos*T
vb <- (A-d0)/T
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("LO26_Panosso18_receptor_simbolica.png", dir="../../../../figuras")
img <- "LO26_Panosso18_receptor_simbolica.png"
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
No instante $t=0$, o atleta A lança uma bola com $v_0=\Sexpr{v0}\,\mathrm{m/s}$ a $\Sexpr{theta}^\circ$ da horizontal. O atleta B está a uma distância $D=\Sexpr{d0}\,\mathrm{m}$ à frente de A e corre na mesma direção, com velocidade constante, para apanhar a bola quando ela volta à mesma altura do lançamento. Use $\sin\Sexpr{theta}^\circ=\Sexpr{fmt(sen,4)}$, $\cos\Sexpr{theta}^\circ=\Sexpr{fmt(cos,4)}$ e $g=10\,\mathrm{m/s^2}$.
\begin{center}\includegraphics[width=9cm,keepaspectratio]{\Sexpr{img}}\end{center}
Determine a velocidade de B.
\begin{answerlist}
  \item velocidade, em $\mathrm{m/s}$.
\end{answerlist}
\end{question}

\begin{solution}
$T=\Sexpr{fmt(T)}\,\mathrm{s}$ e a bola retorna ao nível de lançamento em $A=\Sexpr{fmt(A)}\,\mathrm{m}$. Como B parte a uma distância $D=\Sexpr{d0}\,\mathrm{m}$ de A, ele percorre $A-D$ no mesmo tempo. Portanto,
\[
v_B=\frac{A-D}{T}=\Sexpr{fmt(vb)}\,\mathrm{m/s}.
\]
\begin{answerlist}
  \item $\Sexpr{fmt(vb)}$
\end{answerlist}
\end{solution}

