<<echo=FALSE, results=hide>>=
g <- 10
configs <- data.frame(theta=c(30,37,45,53,60), d0=c(10,12,15,18,20), sen=c(0.50,0.60,0.7071,0.80,0.866), cos=c(0.866,0.80,0.7071,0.60,0.50))
i <- sample(seq_len(nrow(configs)),1)
theta<-configs$theta[i]; d0<-configs$d0[i]; sen<-configs$sen[i]; cos<-configs$cos[i]
v0<-sample(c(20,25,30,35),1)
T<-2*v0*sen/g; A<-v0*cos*T; vb<-(A-d0)/T
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("LO26_Panosso18_receptor_base.png", dir="../../../../figuras")
base_path <- "LO26_Panosso18_receptor_base.png"
render_overlay_png <- function(source, outfile, overlays) {
img <- png::readPNG(source)
  h <- dim(img)[1]
  w <- dim(img)[2]
  grDevices::png(outfile, width=w, height=h, bg="white")
  grid::grid.newpage()
  grid::grid.raster(img, width=grid::unit(1,"npc"), height=grid::unit(1,"npc"), interpolate=FALSE)
  for (o in overlays) {
    grid::grid.rect(
      x=grid::unit((o$x1+o$x2)/(2*w),"npc"),
      y=grid::unit(1-(o$y1+o$y2)/(2*h),"npc"),
      width=grid::unit((o$x2-o$x1)/w,"npc"),
      height=grid::unit((o$y2-o$y1)/h,"npc"),
      gp=grid::gpar(fill="white", col=NA)
    )
    rot <- if (is.null(o$rot)) 0 else o$rot
    fontsize <- if (is.null(o$fontsize)) 12 else o$fontsize
    just <- if (is.null(o$just)) c("left","top") else o$just
    grid::grid.text(
      o$text,
      x=grid::unit(o$x/w,"npc"), y=grid::unit(1-o$y/h,"npc"),
      just=just, rot=rot,
      gp=grid::gpar(col="black", fontsize=fontsize, fontfamily="serif")
    )
  }
  grDevices::dev.off()
  invisible(outfile)
}
img <- "Q11_Receptor.png"
render_overlay_png(base_path, img, list(
  list(x1=100,y1=43,x2=171,y2=87,text=paste0(theta,"°"),x=114,y=52,fontsize=13),
  list(x1=259,y1=156,x2=365,y2=199,text=paste0(d0," m"),x=282,y=164,fontsize=13)
))
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
No instante $t=0$, o atleta A lança uma bola com $v_0=\Sexpr{v0}\,\mathrm{m/s}$ a $\Sexpr{theta}^\circ$ da horizontal. O atleta B está $\Sexpr{d0}\,\mathrm{m}$ à frente de A e corre na mesma direção, com velocidade constante, para apanhar a bola quando ela volta à mesma altura do lançamento. Use $\sin\Sexpr{theta}^\circ=\Sexpr{fmt(sen,4)}$, $\cos\Sexpr{theta}^\circ=\Sexpr{fmt(cos,4)}$ e $g=10\,\mathrm{m/s^2}$.
\begin{center}\includegraphics[width=9cm,keepaspectratio]{\Sexpr{img}}\end{center}
Determine a velocidade de B.
\begin{answerlist}
  \item velocidade, em $\mathrm{m/s}$.
\end{answerlist}
\end{question}
\begin{solution}
$T=\Sexpr{fmt(T)}\,\mathrm{s}$ e a bola retorna ao nível de lançamento em $A=\Sexpr{fmt(A)}\,\mathrm{m}$. B percorre $A-d_0$ no mesmo tempo, então $v_B=\Sexpr{fmt(vb)}\,\mathrm{m/s}$.
\begin{answerlist}
  \item $\Sexpr{fmt(vb)}$
\end{answerlist}
\end{solution}
