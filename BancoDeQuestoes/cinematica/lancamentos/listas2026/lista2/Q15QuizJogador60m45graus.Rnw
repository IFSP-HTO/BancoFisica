<<echo=FALSE, results=hide>>=
g <- 10
configs <- data.frame(theta=c(30,37,45,53,60), D=c(60,70,60,75,65), sen=c(0.50,0.60,0.7071,0.80,0.866), cos=c(0.866,0.80,0.7071,0.60,0.50))
i <- sample(seq_len(nrow(configs)),1)
theta<-configs$theta[i]; D<-configs$D[i]; sen<-configs$sen[i]; cos<-configs$cos[i]
v0<-sample(c(15,18,20),1)
T<-2*v0*sen/g; A<-v0*cos*T; vp<-abs(D-A)/T
opts<-c(vp,0.8*vp,1.2*vp,1.5*vp,2*vp)
fmt<-function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
include_supplement("LO26_Panosso25_jogador_base.png", dir="../../../../figuras")
base_path <- "LO26_Panosso25_jogador_base.png"
render_overlay_png <- function(source, outfile, overlays) {
img <- png::readPNG(source)
  h <- dim(img)[1]
  w <- dim(img)[2]
  grDevices::png(outfile, width=w, height=h, bg="white")
  grid::grid.newpage()
  grid::grid.raster(img, width=grid::unit(1,"npc"), height=grid::unit(1,"npc"), interpolate=FALSE)
  for (o in overlays) {
    grid::grid.rect(
      x=grid::unit((o$x1+o$x2)/(2*w),"npc"),
      y=grid::unit(1-(o$y1+o$y2)/(2*h),"npc"),
      width=grid::unit((o$x2-o$x1)/w,"npc"),
      height=grid::unit((o$y2-o$y1)/h,"npc"),
      gp=grid::gpar(fill="white", col=NA)
    )
    rot <- if (is.null(o$rot)) 0 else o$rot
    fontsize <- if (is.null(o$fontsize)) 12 else o$fontsize
    just <- if (is.null(o$just)) c("left","top") else o$just
    grid::grid.text(
      o$text,
      x=grid::unit(o$x/w,"npc"), y=grid::unit(1-o$y/h,"npc"),
      just=just, rot=rot,
      gp=grid::gpar(col="black", fontsize=fontsize, fontfamily="serif")
    )
  }
  grDevices::dev.off()
  invisible(outfile)
}
img <- "Q15_Jogador.png"
render_overlay_png(base_path, img, list(
  list(x1=100,y1=67,x2=174,y2=112,text=paste0(theta,"°"),x=115,y=76,fontsize=13),
  list(x1=252,y1=154,x2=365,y2=201,text=paste0(D," m"),x=282,y=163,fontsize=13)
))
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
Uma bola é chutada com velocidade $\Sexpr{v0}\,\mathrm{m/s}$ a $\Sexpr{theta}^\circ$ com a horizontal. No mesmo instante, um jogador parado a $\Sexpr{D}\,\mathrm{m}$ do ponto onde ocorreu o chute começa a correr, no mesmo plano vertical da trajetória, para se encontrar com a bola no instante em que ela atinge o gramado. Despreze o ar e adote $g=10\,\mathrm{m/s^2}$, $\sin\Sexpr{theta}^\circ=\Sexpr{fmt(sen,4)}$ e $\cos\Sexpr{theta}^\circ=\Sexpr{fmt(cos,4)}$. Qual deve ser o módulo da velocidade média do jogador?
\begin{center}\includegraphics[width=9cm,keepaspectratio]{\Sexpr{img}}\end{center}
\begin{answerlist}
\item $\Sexpr{fmt(opts[1])}\,\mathrm{m/s}$\item $\Sexpr{fmt(opts[2])}\,\mathrm{m/s}$\item $\Sexpr{fmt(opts[3])}\,\mathrm{m/s}$\item $\Sexpr{fmt(opts[4])}\,\mathrm{m/s}$\item $\Sexpr{fmt(opts[5])}\,\mathrm{m/s}$
\end{answerlist}
\end{question}
\begin{solution}
$T=\Sexpr{fmt(T)}\,\mathrm{s}$ e $A=\Sexpr{fmt(A)}\,\mathrm{m}$. O jogador percorre $|D-A|=\Sexpr{fmt(abs(D-A))}\,\mathrm{m}$, logo $v=\Sexpr{fmt(vp)}\,\mathrm{m/s}$.
\begin{answerlist}
  \item correta
  \item incorreta
  \item incorreta
  \item incorreta
  \item incorreta
\end{answerlist}
\end{solution}
