img1 <- "Q01_UFTM_fig1.png"
img2 <- "Q01_UFTM_fig2.png"
render_overlay_png(base1_path, img1, list(
  list(x1=215,y1=300,x2=305,y2=343,text=paste0(dx," m"),x=230,y=305,fontsize=13)
))
render_overlay_png(base2_path, img2, list(
  list(x1=245,y1=15,x2=385,y2=54,text=paste0("Vx = ",vx," m/s"),x=258,y=20,fontsize=12),
  list(x1=350,y1=52,x2=500,y2=93,text=paste0("Vy = ",vy," m/s"),x=365,y=58,fontsize=12),
  list(x1=188,y1=266,x2=300,y2=308,text=paste0(dx," m"),x=212,y=274,fontsize=12)
))
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
Num jogo de vôlei, uma atacante imprime à bola componentes de velocidade de módulos
$V_x=\Sexpr{vx}\,\mathrm{m/s}$ e $V_y=\Sexpr{vy}\,\mathrm{m/s}$, sendo a componente vertical dirigida para baixo. A bola percorre $\Sexpr{dx}\,\mathrm{m}$ horizontalmente até tocar o solo. Adote $g=10\,\mathrm{m/s^2}$. Qual era a altura $h$ da bola no instante da cortada?

\begin{center}
\includegraphics[width=6.5cm,keepaspectratio]{\Sexpr{img1}}
\qquad
\includegraphics[width=6.5cm,keepaspectratio]{\Sexpr{img2}}
\end{center}

\begin{answerlist}
  \item $\Sexpr{fmt(alts[1])}\,\mathrm{m}$
  \item $\Sexpr{fmt(alts[2])}\,\mathrm{m}$
  \item $\Sexpr{fmt(alts[3])}\,\mathrm{m}$
  \item $\Sexpr{fmt(alts[4])}\,\mathrm{m}$
  \item $\Sexpr{fmt(alts[5])}\,\mathrm{m}$
\end{answerlist}
\end{question}

\begin{solution}
O tempo de voo após a cortada é $t=\Delta x/V_x=\Sexpr{fmt(t)}\,\mathrm{s}$. Tomando para baixo como positivo,
\[
h=V_y t+\frac12gt^2=\Sexpr{fmt(h)}\,\mathrm{m}.
\]
\begin{answerlist}
  \item incorreta
  \item incorreta
  \item correta
  \item incorreta
  \item incorreta
\end{answerlist}
\end{solution}

