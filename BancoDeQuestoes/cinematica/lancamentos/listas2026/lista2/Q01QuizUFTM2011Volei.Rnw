<<echo=FALSE, results=hide>>=
g <- 10
configs <- expand.grid(vx=c(8,10,12), vy=c(2,3,4), dx=c(4,5,6))
configs <- subset(configs, dx/vx >= 0.35 & dx/vx <= 0.75)
i <- sample(seq_len(nrow(configs)), 1)
vx <- configs$vx[i]; vy <- configs$vy[i]; dx <- configs$dx[i]
t <- dx/vx
h <- vy*t + 0.5*g*t^2
alts <- h + c(-0.50,-0.25,0,0.25,0.50)
fmt <- function(x,d=2) formatC(x,format="f",digits=d,decimal.mark=",")
render_overlay_png <- function(source, outfile, overlays) {
  img <- png::readPNG(source)
  h <- dim(img)[1]
  w <- dim(img)[2]
  grDevices::png(outfile, width=w, height=h, bg="white")
  grid::grid.newpage()
  grid::grid.raster(img, width=grid::unit(1,"npc"), height=grid::unit(1,"npc"), interpolate=FALSE)
  for (o in overlays) {
    grid::grid.rect(
      x=grid::unit((o$x1+o$x2)/(2*w),"npc"),
      y=grid::unit(1-(o$y1+o$y2)/(2*h),"npc"),
      width=grid::unit((o$x2-o$x1)/w,"npc"),
      height=grid::unit((o$y2-o$y1)/h,"npc"),
      gp=grid::gpar(fill="white", col=NA)
    )
    rot <- if (is.null(o$rot)) 0 else o$rot
    fontsize <- if (is.null(o$fontsize)) 12 else o$fontsize
    just <- if (is.null(o$just)) c("left","top") else o$just
    grid::grid.text(
      o$text,
      x=grid::unit(o$x/w,"npc"), y=grid::unit(1-o$y/h,"npc"),
      just=just, rot=rot,
      gp=grid::gpar(col="black", fontsize=fontsize, fontfamily="serif")
    )
  }
  grDevices::dev.off()
  invisible(outfile)
}
include_supplement("LO26_UFTM2011_volei_fig1_base.png", dir="../../../../figuras")
base1_path <- "LO26_UFTM2011_volei_fig1_base.png"
