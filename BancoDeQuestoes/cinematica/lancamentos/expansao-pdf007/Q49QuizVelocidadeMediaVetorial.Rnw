include_supplement("PM007_Q49_revisada.png", dir="../../../figuras")
img <- "PM007_Q49_revisada.png"
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}

A figura representa a trajetória bidimensional de uma partícula no plano
$xy$. A partícula passa pelo ponto $P$ no instante $t$ e pelo ponto $Q$ exatamente
$1\,\mathrm{s}$ depois.

\begin{center}
\includegraphics[width=7cm,keepaspectratio]{\Sexpr{img}}
\end{center}

No Sistema Internacional, o vetor velocidade média da partícula entre $P$ e
$Q$ é

\begin{answerlist}
  \item $6\,\hat{\imath}+3\,\hat{\jmath}\,\mathrm{m/s}$
  \item $2\,\hat{\imath}+3\,\hat{\jmath}\,\mathrm{m/s}$
  \item $2\,\hat{\imath}+2\,\hat{\jmath}\,\mathrm{m/s}$
  \item $6\,\hat{\imath}+2\,\hat{\jmath}\,\mathrm{m/s}$
  \item $3\,\hat{\imath}+6\,\hat{\jmath}\,\mathrm{m/s}$
\end{answerlist}

\end{question}

\begin{solution}

Da figura,
\[
P=(2,4)\,\mathrm{m},
\qquad
Q=(8,6)\,\mathrm{m}.
\]
Logo, o deslocamento no intervalo é
\[
\Delta\vec r
=(8-2)\hat{\imath}+(6-4)\hat{\jmath}
=6\hat{\imath}+2\hat{\jmath}\,\mathrm{m}.
\]

Como $\Delta t=1\,\mathrm{s}$,
\[
\vec v_m=\frac{\Delta\vec r}{\Delta t}
=6\hat{\imath}+2\hat{\jmath}\,\mathrm{m/s}.
\]

\begin{answerlist}
  \item incorreta
  \item incorreta
  \item incorreta
  \item correta
  \item incorreta
\end{answerlist}

\end{solution}

