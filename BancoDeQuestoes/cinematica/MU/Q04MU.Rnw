<<echo=FALSE, results=hide>>=
## Parâmetros
lap <- sample(seq(100,300,10),1)
speed <- sample(seq(from=1,to=5,by=1),1)
time <- sample(seq(from=10,to=40,by=1), 1)

## Resposta
result <- floor((speed*time*60)/lap)
@
\usepackage[utf8]{inputenc}
\begin{question}
Uma pessoa caminha numa pista de Cooper de $\Sexpr{lap}$ metros de comprimento, com velocidade média de $\Sexpr{speed}$ m/s. Quantas \textbf{voltas completas} ela completará em $\Sexpr{time}$ minutos? 

\end{question}

%% SOLUTION
\begin{solution}
Em \(\Sexpr{time}\) min, o tempo total é
\[
  t=60\cdot\Sexpr{time}\,\mathrm{s}.
\]
A distância percorrida nesse intervalo é
\[
  d=vt=\Sexpr{speed}\cdot60\cdot\Sexpr{time}\,\mathrm{m}.
\]
O número de voltas é a distância dividida pelo comprimento da pista. Como são pedidas apenas voltas completas, tomamos a parte inteira:
\[
  N=\left\lfloor\frac{d}{\Sexpr{lap}}\right\rfloor
   =\Sexpr{result}.
\]
Portanto, a pessoa completa \(\Sexpr{result}\) voltas.

\end{solution}

