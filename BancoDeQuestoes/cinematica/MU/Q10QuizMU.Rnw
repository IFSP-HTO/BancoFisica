<<echo=FALSE, results=hide>>=
## Parâmetros
v1 <- sample(seq(from=20,to=40,by=5),1)
v2 <- (v1 - 15)
comprimento <- sample(seq(100,200,10),1)

## Resposta
tempo_ultrapassagem <- comprimento/(v1 - v2)
resp <- round(tempo_ultrapassagem*v1,1)

aleat <- sample(1:5)
questions <- numeric(5)
solutions <- logical(5)

  questions[aleat[1]] <- resp
  solutions[aleat[1]] <- TRUE
  
  questions[aleat[2]] <- resp-50
  solutions[aleat[2]] <- FALSE
  
  questions[aleat[3]] <- resp-30
  solutions[aleat[3]] <- FALSE
  
  questions[aleat[4]] <- resp+20
  solutions[aleat[4]] <- FALSE
  
  questions[aleat[5]] <- resp+50
  solutions[aleat[5]] <- FALSE
@
\usepackage[utf8]{inputenc}
\begin{question}
Uma motocicleta com velocidade constante de \Sexpr{v1} m/s ultrapassa um trem de comprimento \Sexpr{comprimento} m e velocidade \Sexpr{v2} m/s. Qual foi o deslocamento da motocicleta durante a ultrapassagem?

<<echo=FALSE, results=hide, results=tex>>=
answerlist(questions)
@
\end{question}

\begin{solution}
Durante a ultrapassagem, a motocicleta precisa avançar, em relação ao trem, uma distância igual ao comprimento do trem. A velocidade relativa é
\[
  v_{\mathrm{rel}}=\Sexpr{v1}-\Sexpr{v2}=\Sexpr{v1-v2}\,\mathrm{m/s}.
\]
Logo, o tempo de ultrapassagem é
\[
  t=\frac{\Sexpr{comprimento}}{\Sexpr{v1-v2}}
   =\Sexpr{tempo_ultrapassagem}\,\mathrm{s}.
\]
Nesse intervalo, a motocicleta se desloca
\[
  \Delta s=v_1t
          =\Sexpr{v1}\cdot\Sexpr{tempo_ultrapassagem}
          =\Sexpr{resp}\,\mathrm{m}.
\]

<<echo=FALSE, results=hide, results=tex>>=
answerlist(ifelse(solutions, paste("\\textbf{", questions, "}", sep=""), questions))
@

\end{solution}

