<<echo=FALSE, results=hide>>=

# Created by vinibrenobr11 on 12/06/2017 at 19:58

# Define o número de elementos do trem de 10 a 20, incluindo a locomotiva 
elements <- sample(seq(from=10, to=20, by=1), 1)

# Define a velocidade do trem
speed <- sample(seq(from=15, to=30, by=1), 1)

# Define os resultado dos itens A e B
result_a <- round((20 * elements) / speed, 2)
result_b <- round((20 * elements + 100) / speed, 2)

options(OutDec=",")
@

\begin{question}

  Uma composi\c{c}\~ao ferrovi\'aria (\Sexpr{elements-1} vag\~oes e uma locomotiva) desloca-se a \Sexpr{speed} m/s. Sendo o comprimento de cada elemento da composi\c{c}\~ao 20 m, qual \'e o tempo em segundos que o trem gasta para ultrapassar:

  \begin{answerlist}

    \item Um sinaleiro?

    \item Uma ponte de 100m de comprimento?

  \end{answerlist}

\end{question}

%% SOLUTION

\begin{solution}
O comprimento total da composição é
\[
  L=20\cdot\Sexpr{elements}=\Sexpr{20*elements}\,\mathrm{m}.
\]

Para ultrapassar um sinaleiro, o trem precisa avançar uma distância igual ao próprio comprimento:
\[
  t_1=\frac{L}{v}
     =\frac{\Sexpr{20*elements}}{\Sexpr{speed}}
     =\Sexpr{result_a}\,\mathrm{s}.
\]

Para atravessar completamente uma ponte de \(100\,\mathrm{m}\), a frente do trem deve percorrer \(L+100\):
\[
  t_2=\frac{L+100}{v}
     =\frac{\Sexpr{20*elements+100}}{\Sexpr{speed}}
     =\Sexpr{result_b}\,\mathrm{s}.
\]

\begin{answerlist}
  \item \Sexpr{result_a} s
  \item \Sexpr{result_b} s
\end{answerlist}

\end{solution}

<<echo=FALSE, results=hide>>=
options(OutDec=".")
@
