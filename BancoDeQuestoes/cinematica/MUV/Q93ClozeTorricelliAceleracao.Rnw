<<echo=FALSE, results=hide>>=
## Torricelli com valores construídos para resposta simples.
v0 <- sample(c(4,6,8,10), 1)
a <- sample(c(2,3,4), 1)
ds <- sample(c(12,16,20,24,30), 1)
v <- sqrt(v0^2 + 2*a*ds)
@
\usepackage[utf8]{inputenc}

\begin{question}
Uma motocicleta desloca-se em linha reta com velocidade inicial de $\Sexpr{v0}\,\mathrm{m/s}$. Durante um trecho de $\Sexpr{ds}\,\mathrm{m}$, ela mantém aceleração constante de $\Sexpr{a}\,\mathrm{m/s^2}$ no sentido do movimento.

Sem calcular previamente o tempo, determine o módulo da velocidade ao final do trecho, em $\mathrm{m/s}$.
\end{question}

\begin{solution}
Como o tempo não é fornecido, a relação mais direta é a equação de Torricelli:
\[
v^2=v_0^2+2a\Delta s.
\]
Portanto,
\[
v=\sqrt{\Sexpr{v0}^2+2\cdot\Sexpr{a}\cdot\Sexpr{ds}}
=\Sexpr{round(v,2)}\,\mathrm{m/s}.
\]
\end{solution}

