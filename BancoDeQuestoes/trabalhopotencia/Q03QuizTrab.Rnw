<<echo=FALSE, results=hide>>=
## PROGRAMADO POR CARLOS SANTANA EM 06 DE JUNHO DE 2018
## REVISADO EM AGOSTO DE 2026: correções de unidades, sinal do trabalho do atrito e altura.

## PARÂMETROS
const_elast <- sample(seq(from=100,to=400,by=25),1)
compressao_m <- sample(seq(from=0.10,to=0.20,by=0.01),1)
compressao_cm <- round(100*compressao_m,0)
massa_kg <- sample(seq(from=0.2,to=0.8,by=0.1),1)
massa_g <- round(1000*massa_kg,0)
g <- 10

pot_elast <- 0.5*const_elast*(compressao_m^2)
pot_elast_pontoB <- 0.8*pot_elast
trabalho_atrito <- -0.2*pot_elast
altura_m <- pot_elast_pontoB/(massa_kg*g)
altura_cm <- 100*altura_m

fmt <- function(x, d=2) formatC(x, format="f", digits=d, decimal.mark=",")

## RESPOSTAS
questions <- character(7)
solutions <- logical(7)
aleat <- sample(1:7)

questions[aleat[1]] <- "Na situação descrita, há conservação da energia mecânica do bloco."
solutions[aleat[1]] <- FALSE

questions[aleat[2]] <- paste0("A energia mecânica do bloco no ponto B é aproximadamente ", fmt(pot_elast_pontoB), " J.")
solutions[aleat[2]] <- TRUE

questions[aleat[3]] <- paste0("O trabalho realizado pela força de atrito sobre o bloco, entre A e B, é aproximadamente ", fmt(trabalho_atrito), " J.")
solutions[aleat[3]] <- TRUE

questions[aleat[4]] <- paste0("O ponto B situa-se a aproximadamente ", fmt(altura_cm,1), " cm de altura em relação ao ponto A.")
solutions[aleat[4]] <- TRUE

questions[aleat[5]] <- "Como a força de atrito realiza trabalho no deslocamento entre A e B, a energia mecânica do bloco não se conserva."
solutions[aleat[5]] <- TRUE

questions[aleat[6]] <- paste0("A energia mecânica total do bloco no ponto A é aproximadamente ", fmt(pot_elast), " J.")
solutions[aleat[6]] <- TRUE

questions[aleat[7]] <- "A energia potencial elástica inicialmente armazenada não contribui para o aumento da energia potencial gravitacional do bloco."
solutions[aleat[7]] <- FALSE

## FIGURA
include_supplement("Q03QuizTrab.png")
@

\begin{question}
(UFSC-adapt.) A figura mostra um bloco de massa $m=\Sexpr{massa_g}\,\mathrm{g}$, mantido encostado em uma mola comprimida de $x=\Sexpr{compressao_cm}\,\mathrm{cm}$. A constante elástica da mola é $k=\Sexpr{const_elast}\,\mathrm{N/m}$. A mola é solta e empurra o bloco que, partindo do repouso no ponto A, atinge o ponto B, onde para momentaneamente. No percurso entre A e B, a força de atrito dissipa 20\% da energia mecânica inicial. Adote $g=10\,\mathrm{m/s^2}$.

\begin{figure}[h!]
  \centering
  \includegraphics[width=6cm, keepaspectratio]{Q03QuizTrab.png}
\end{figure}

Assinale a(s) proposição(ões) correta(s):
<<echo=FALSE, results=hide, results=tex>>=
answerlist(questions)
@
\end{question}

\begin{solution}

A energia mecânica inicial é apenas a energia potencial elástica:
\[
E_{m,A}=\frac{kx^2}{2}=\Sexpr{fmt(pot_elast)}\,\mathrm{J}.
\]
Como 20\% dessa energia é dissipada pelo atrito,
\[
E_{m,B}=0{,}80E_{m,A}=\Sexpr{fmt(pot_elast_pontoB)}\,\mathrm{J},
\]
e o trabalho do atrito é negativo:
\[
W_{at}=-0{,}20E_{m,A}=\Sexpr{fmt(trabalho_atrito)}\,\mathrm{J}.
\]
No ponto B o bloco para momentaneamente; portanto sua energia cinética é nula e a energia restante é potencial gravitacional:
\[
mgh=E_{m,B}.
\]
Assim, $h\approx\Sexpr{fmt(altura_cm,1)}\,\mathrm{cm}$.

<<echo=FALSE, results=hide, results=tex>>=
answerlist(
  paste("\\textbf{", ifelse(solutions, "Verdadeiro", "Falso"), "}"))
@
\end{solution}

