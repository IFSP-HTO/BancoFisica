<<echo=FALSE, results=hide>>=
##Programado por:Matheus V
##Variaveis
massa <- sample(seq(from=800,to=1200,by=100),1)
velocidadeKM <-  sample(seq(from=60,to=100,by=10),1)
velocidadeMS <-  round(velocidadeKM/3.6 , digits = 2)

## Desnível lido na figura: y = 35 m em x = 20 m e y = 15 m em x = 120 m.
g <- 10
dh <- 35 - 15
v2 <- velocidadeMS^2 + 2*g*dh

resp1 <- round(sqrt(v2/2), digits = 2)
resp2 <- round(massa*v2/4, digits = 1)

##Imagem
include_supplement("Q18Trab.png")
@
\usepackage[portuguese]{babel}

\begin{question}
 
        (Unicamp) O famoso cientista, Dr. Vest B. Lando, dirige calmamente o seu automóvel de massa = \Sexpr{massa} kg pela estrada cujo perfil está mostrado na figura a seguir. Na posição x = 20 m, quando sua velocidade vale V = \Sexpr{velocidadeKM} km/h, ele percebe uma pedra ocupando toda a estrada na posição x = 120 m (ver figura). Se o Dr. Lando não acelerar ou acionar os freios, o automóvel (devido a atritos internos e externos) chega na posição da pedra com metade da energia cinética que teria caso não houvesse qualquer dissipação de energia
        
  \begin{figure}[h!]
    \centering
    \includegraphics[height=5cm, keepaspectratio]{Q18Trab.png}
  \end{figure}

  \begin{answerlist}

    \item Com que velocidade o automóvel se chocará com a pedra se o Dr. Lando não acelerar ou acionar os freios? 

  
    \item Que energia tem que ser dissipada com os freios acionados para que o automóvel pare rente à pedra?

  \end{answerlist}

\end{question}

\begin{solution}
Da figura, entre \(x=20\,\mathrm m\) e \(x=120\,\mathrm m\) o carro desce de \(y=35\,\mathrm m\) para \(y=15\,\mathrm m\), ou seja, \(\Delta h=20\,\mathrm m\). A velocidade inicial é
\[
  v_0=\frac{\Sexpr{velocidadeKM}}{3{,}6}=\Sexpr{velocidadeMS}\,\mathrm{m/s}.
\]

Se não houvesse dissipação, a conservação da energia mecânica daria
\[
  v_{\text{ideal}}^2=v_0^2+2g\Delta h
    =\Sexpr{velocidadeMS}^2+2\cdot10\cdot20
    =\Sexpr{v2}.
\]
Como ao chegar à pedra a energia cinética é metade da ideal,
\[
  K_{\text{real}}=\frac12 K_{\text{ideal}}
  \quad\Rightarrow\quad
  v_{\text{real}}=\frac{v_{\text{ideal}}}{\sqrt2},
\]
\[
  v_{\text{real}}=\sqrt{\frac{\Sexpr{v2}}{2}}
    =\Sexpr{resp1}\,\mathrm{m/s}.
\]

Para parar rente à pedra, os freios devem dissipar toda a energia cinética restante:
\[
  E_{\text{diss}}=K_{\text{real}}=\frac12 m v_{\text{real}}^2
   =\frac{m}{4}\bigl(v_0^2+2g\Delta h\bigr)
   =\frac{\Sexpr{massa}\cdot\Sexpr{v2}}{4}
   =\Sexpr{resp2}\,\mathrm J.
\]

\begin{answerlist}

  \item \(\Sexpr{resp1}\,\mathrm{m/s}\)

  \item \(\Sexpr{resp2}\,\mathrm J\)

\end{answerlist}

\end{solution}

