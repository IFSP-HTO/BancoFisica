<<echo=FALSE, results=hide>>=
## Data generation by Flavio Barros

## Parâmetros
densidade <- sample(seq(0.8, 7.8, by = 0.2), 1)
fator <- sample(2:4, 1)
aresta2 <- sample(2:6, 1)
aresta1 <- fator * aresta2
massa1 <- round(densidade * aresta1^3, 1)

## Resposta calculada a partir dos dados efetivamente exibidos
massa2 <- round(massa1 * (aresta2 / aresta1)^3, 1)
@

\begin{question}
Um cubo homogêneo tem aresta $\Sexpr{aresta1}\,\mathrm{cm}$ e massa
$\Sexpr{massa1}\,\mathrm{g}$. Outro cubo, feito do mesmo material, tem aresta
$\Sexpr{aresta2}\,\mathrm{cm}$.

Qual é a massa do segundo cubo, em gramas? Arredonde para uma casa decimal.
\end{question}

\begin{solution}
Como os cubos são feitos do mesmo material, possuem a mesma densidade. Logo, a
massa é proporcional ao volume.

Para um cubo, $V=a^3$. Portanto,
\[
\frac{m_2}{m_1}
=\frac{V_2}{V_1}
=\left(\frac{a_2}{a_1}\right)^3.
\]

Substituindo os valores,
\[
m_2
=\Sexpr{massa1}
\left(\frac{\Sexpr{aresta2}}{\Sexpr{aresta1}}\right)^3
=\Sexpr{massa2}\,\mathrm{g}.
\]

Logo, a massa do segundo cubo é $\Sexpr{massa2}\,\mathrm{g}$.
\end{solution}

