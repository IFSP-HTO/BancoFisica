%% SOURCE-VISUAL: ilustração aprovada pelo professor; detalhes em data/lista2-imagens-aprovadas.json.
<<echo=FALSE, results=hide>>=
## Registrar o PNG como suplemento para exams2pdf e exams2moodle.
include_supplement("Q105PascalForca.png")
A1 <- sample(c(10,15,20,25),1)
f <- sample(3:8,1)
A2 <- A1*f
F1 <- sample(c(40,50,60),1)
F2 <- F1*f
@

\begin{question}
Um elevador hidráulico tem êmbolos com áreas de \(\Sexpr{A1}\,\mathrm{cm^2}\) e \(\Sexpr{A2}\,\mathrm{cm^2}\), à mesma altura. Aplica-se no menor uma força de \(\Sexpr{F1}\,\mathrm N\). Despreze perdas, atritos e pesos dos êmbolos.

\begin{center}
\includegraphics[width=7cm,keepaspectratio]{Q105PascalForca.png}
\end{center}

\textit{Ilustração selecionada pelo professor; use os valores sorteados no enunciado.}

Qual é a força transmitida ao êmbolo maior, em newtons?
\end{question}

\begin{solution}
Pelo princípio de Pascal,
\[
\frac{F_1}{A_1}=\frac{F_2}{A_2}
\quad\Rightarrow\quad
F_2=\Sexpr{F1}\frac{\Sexpr{A2}}{\Sexpr{A1}}
=\Sexpr{F2}\,\mathrm N.
\]
\end{solution}

