<<echo=FALSE, results=hide>>=
## Criado por Flavio Barros 03/06/2018

nota_cient <- function(x, digits) {
  if (x == 0) return("0")
  ord <- floor(log(abs(x), 10))
  x <- x / 10^ord
  if (!missing(digits)) x <- format(x, digits = digits)
  if (ord == 0) return(as.character(x))
  paste(x, "\\times 10^{", ord, "}", sep = "")
}

## Parâmetros
h <- sample(4:11, 1)
g <- 10
atm <- 1e5
rho <- 1000

## Respostas
p <- atm + rho * g * h
delta_p <- 0

## Figura
include_supplement(file = 'Q07LeiStevin.png')
@

\begin{question}
(Unicamp) Um mergulhador persegue um peixe a uma profundidade
$h=\Sexpr{h}\,\mathrm{m}$ abaixo da superfície de um lago. O peixe foge da
posição A e se esconde em uma gruta na posição B, conforme mostra a figura.

A pressão atmosférica na superfície é
$\Sexpr{nota_cient(atm)}\,\mathrm{Pa}$. Considere a densidade da água igual a
$\Sexpr{rho}\,\mathrm{kg/m^3}$ e adote $g=\Sexpr{g}\,\mathrm{m/s^2}$.

\includegraphics[height=6cm,keepaspectratio]{Q07LeiStevin.png}

\begin{answerlist}
  \item Qual é a pressão absoluta sobre o mergulhador?
  \item Qual é a variação de pressão sobre o peixe ao passar da posição A para a posição B?
\end{answerlist}
\end{question}

\begin{solution}
A pressão absoluta a uma profundidade $h$ é dada pela lei de Stevin:
\[
P=P_{\text{atm}}+\rho gh.
\]

Assim,
\[
P=
\Sexpr{nota_cient(atm)}
+\Sexpr{rho}\cdot\Sexpr{g}\cdot\Sexpr{h}
=\Sexpr{nota_cient(p)}\,\mathrm{Pa}.
\]

Para comparar as posições A e B, basta usar
\[
\Delta P=\rho g\,\Delta h.
\]
Como A e B estão à mesma profundidade, a variação de altura é
$\Delta h=0$. Portanto,
\[
\Delta P=0\,\mathrm{Pa}.
\]

\begin{answerlist}
  \item $\Sexpr{nota_cient(p)}\,\mathrm{Pa}$.
  \item $\Sexpr{delta_p}\,\mathrm{Pa}$.
\end{answerlist}
\end{solution}

