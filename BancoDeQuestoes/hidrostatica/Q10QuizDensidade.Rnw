<<echo=FALSE, results=hide>>=
## Feita por Flavio Barros
library(MASS)

## Parâmetros
dens_x <- sample(seq(0.60, 1.00, by = 0.05), 1)
dens_y <- dens_x - sample(seq(0.05, 0.30, by = 0.05), 1)
frac_num <- sample(seq(0.10, 0.45, by = 0.05), 1)
frac <- fractions(frac_num)

## Alternativa correta
resp <- (dens_x * frac_num) / (dens_y * (1 - frac_num))

## Distratores
erros <- c(
  dens_x / dens_y,
  (dens_x * frac_num) / dens_y,
  (dens_x * (1 - frac_num)) / dens_y,
  dens_x / (dens_y * (1 - frac_num))
)

lista <- c(resp, erros)
solutions <- c(TRUE, rep(FALSE, 4))

## Figura
include_supplement('Q10QuizDensidade.png')
@

\begin{question}
(Uece) Dois líquidos não miscíveis, X e Y, são derramados sucessivamente em
um vaso cilíndrico. O líquido X, de massa específica
$\Sexpr{dens_x}\,\mathrm{g/cm^3}$, ocupa inicialmente a fração
$\Sexpr{frac}$ do volume total do vaso. Em seguida, adiciona-se o líquido Y,
de massa específica $\Sexpr{dens_y}\,\mathrm{g/cm^3}$, até completar o
volume do recipiente.

Se $m_X$ e $m_Y$ são as massas dos líquidos X e Y, respectivamente, a razão
$m_X/m_Y$ vale:

\includegraphics[height=5cm, keepaspectratio]{Q10QuizDensidade.png}

<<echo=FALSE, results=tex>>=
answerlist(fractions(lista))
@
\end{question}

\begin{solution}
Se $V$ é o volume total do recipiente, então
\[
V_X=\Sexpr{frac}\,V
\]
e
\[
V_Y=(1-\Sexpr{frac})V.
\]

Como $m=\rho V$,
\[
\frac{m_X}{m_Y}
=
\frac{\rho_XV_X}{\rho_YV_Y}
=
\frac{\rho_X\,\Sexpr{frac}}
{\rho_Y(1-\Sexpr{frac})}.
\]

Substituindo as densidades,
\[
\frac{m_X}{m_Y}
=
\frac{\Sexpr{dens_x}\cdot\Sexpr{frac}}
{\Sexpr{dens_y}\left(1-\Sexpr{frac}\right)}
=
\Sexpr{fractions(resp)}.
\]

Portanto, a alternativa correta é:

<<echo=FALSE, results=tex>>=
answerlist(solutions)
@
\end{solution}

