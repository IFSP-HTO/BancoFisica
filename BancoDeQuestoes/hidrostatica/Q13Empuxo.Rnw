<<echo=FALSE, results=hide>>=
## Marcelo C.

## Parâmetros
g <- 10
rho <- 1                                  # g/cm³
massa <- sample(seq(1, 9, by = 0.1), 1)  # g
volume <- sample((ceiling(massa) + 5):(ceiling(massa) + 25), 1) # cm³
k <- sample(seq(2, 10, by = 0.1), 1)     # N/m

## Conversões para SI
rho_SI <- rho * 1000
massa_SI <- massa * 1e-3
volume_SI <- volume * 1e-6

## Forças e resposta
peso <- massa_SI * g
empuxo <- rho_SI * g * volume_SI
fel <- empuxo - peso
resp <- round((fel / k) * 100, 2)

## Figura
include_supplement('Q13Empuxo.png')
@

\begin{question}
(Unesp) Um corpo de massa $\Sexpr{massa}\,\mathrm{g}$ encontra-se em
equilíbrio, totalmente imerso em água e preso a uma mola esticada fixada ao
fundo do recipiente. A constante elástica da mola é
$\Sexpr{k}\,\mathrm{N/m}$, o volume do corpo é
$\Sexpr{volume}\,\mathrm{cm^3}$ e a densidade da água é
$\Sexpr{rho}\,\mathrm{g/cm^3}$.

Adote $g=\Sexpr{g}\,\mathrm{m/s^2}$ e determine o alongamento da mola, em
centímetros. Arredonde para duas casas decimais.

\includegraphics[height=5cm, keepaspectratio]{Q13Empuxo.png}
\end{question}

\begin{solution}
Como o corpo está em equilíbrio, o empuxo para cima equilibra o peso e a força
elástica, ambos para baixo:
\[
E=P+F_{\text{el}}.
\]
Assim,
\[
F_{\text{el}}=E-P.
\]

Convertendo os dados para o SI:
\[
m=\Sexpr{massa}\,\mathrm{g}
=\Sexpr{massa_SI}\,\mathrm{kg},
\]
\[
V=\Sexpr{volume}\,\mathrm{cm^3}
=\Sexpr{volume_SI}\,\mathrm{m^3},
\]
e
\[
\rho=\Sexpr{rho}\,\mathrm{g/cm^3}
=\Sexpr{rho_SI}\,\mathrm{kg/m^3}.
\]

O empuxo vale
\[
E=\rho gV
=\Sexpr{rho_SI}\cdot\Sexpr{g}\cdot\Sexpr{volume_SI}
=\Sexpr{round(empuxo, 4)}\,\mathrm{N},
\]
enquanto o peso é
\[
P=mg
=\Sexpr{massa_SI}\cdot\Sexpr{g}
=\Sexpr{round(peso, 4)}\,\mathrm{N}.
\]

Logo,
\[
F_{\text{el}}
=E-P
=\Sexpr{round(fel, 4)}\,\mathrm{N}.
\]

Pela lei de Hooke,
\[
F_{\text{el}}=k\Delta x,
\]
de modo que
\[
\Delta x
=\frac{F_{\text{el}}}{k}
=\frac{\Sexpr{round(fel, 4)}}{\Sexpr{k}}\,\mathrm{m}.
\]

Convertendo para centímetros,
\[
\Delta x=\Sexpr{resp}\,\mathrm{cm}.
\]

Portanto, o alongamento da mola é
$\Sexpr{resp}\,\mathrm{cm}$.
\end{solution}

