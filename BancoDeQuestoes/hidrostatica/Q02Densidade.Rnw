<<echo=FALSE, results=hide>>=
## Data generation by Flavio Barros 01/06/2018

## Parâmetros
massa_homem <- sample(60:100, 1)
alt_homem <- round(runif(1, min = 1.65, max = 2.00), 2)
consumo_homem <- sample(seq(1.5, 3.0, by = 0.1), 1)
alt_crianca <- sample(seq(0.9, 1.4, by = 0.1), 1)
g <- 9.8

## Razões de escala
beta <- alt_homem / alt_crianca
beta2 <- beta^2
beta3 <- beta^3

## Respostas
massa_crianca <- massa_homem / beta3
peso_crianca <- round(massa_crianca * g, 1)
consumo_crianca <- round(consumo_homem / beta2, 1)
@

\begin{question}
Se dois corpos geometricamente semelhantes têm todas as dimensões lineares
proporcionais por um fator de escala $\beta$, então suas áreas são
proporcionais a $\beta^2$ e seus volumes a $\beta^3$.

Considere um homem e uma criança geometricamente semelhantes e com a mesma
densidade média. O homem tem massa $\Sexpr{massa_homem}\,\mathrm{kg}$,
altura $\Sexpr{alt_homem}\,\mathrm{m}$ e bebe
$\Sexpr{consumo_homem}\,\mathrm{L}$ de água por dia para repor perdas por
evaporação. Admita que essas perdas sejam proporcionais à área superficial do
corpo.

Use $g=9{,}8\,\mathrm{m/s^2}$ e arredonde as respostas para uma casa decimal.

\begin{answerlist}
  \item Se a altura da criança é $\Sexpr{alt_crianca}\,\mathrm{m}$, qual é o seu peso, em newtons?
  \item Quantos litros de água por dia ela deve beber para repor as perdas por evaporação?
\end{answerlist}
\end{question}

\begin{solution}
A razão entre as dimensões lineares do homem e da criança é
\[
\beta=\frac{H_{\text{homem}}}{H_{\text{criança}}}
=\frac{\Sexpr{alt_homem}}{\Sexpr{alt_crianca}}
\approx \Sexpr{round(beta, 2)}.
\]

Como os corpos têm a mesma densidade média, a massa é proporcional ao volume.
Assim,
\[
\frac{m_{\text{homem}}}{m_{\text{criança}}}=\beta^3,
\]
de modo que
\[
m_{\text{criança}}
=\frac{\Sexpr{massa_homem}}{\Sexpr{round(beta3, 3)}}
\approx \Sexpr{round(massa_crianca, 1)}\,\mathrm{kg}.
\]

O peso da criança é
\[
P=m_{\text{criança}}g
\approx \Sexpr{round(massa_crianca, 1)}\cdot\Sexpr{g}
=\Sexpr{peso_crianca}\,\mathrm{N}.
\]

Já a perda de água por evaporação é proporcional à área superficial. Portanto,
\[
\frac{L_{\text{homem}}}{L_{\text{criança}}}=\beta^2,
\]
e
\[
L_{\text{criança}}
=\frac{\Sexpr{consumo_homem}}{\Sexpr{round(beta2, 3)}}
\approx \Sexpr{consumo_crianca}\,\mathrm{L/dia}.
\]

\begin{answerlist}
  \item $\Sexpr{peso_crianca}\,\mathrm{N}$.
  \item $\Sexpr{consumo_crianca}\,\mathrm{L/dia}$.
\end{answerlist}
\end{solution}

