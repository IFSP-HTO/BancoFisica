<<echo=FALSE, results=hide>>=
m <- sample(c(40,50,60,70,80), 1)
a <- sample(c(1,2,3), 1)
g <- 10
Nup <- m*(g+a)
Ndown <- m*(g-a)
@
\usepackage[utf8]{inputenc}

\begin{question}
Uma pessoa de massa $\Sexpr{m}\,\mathrm{kg}$ está sobre uma balança dentro de um elevador. Adote $g=10\,\mathrm{m/s^2}$.

Determine a indicação da balança, em newtons, quando o elevador:
\begin{answerlist}
  \item acelera para cima com módulo $\Sexpr{a}\,\mathrm{m/s^2}$;
  \item acelera para baixo com o mesmo módulo $\Sexpr{a}\,\mathrm{m/s^2}$.
\end{answerlist}
\end{question}

\begin{solution}
A indicação da balança é o módulo da força normal.

Para aceleração para cima:
\[
N-mg=ma \quad\Rightarrow\quad N=m(g+a)=\Sexpr{Nup}\,\mathrm{N}.
\]
Para aceleração para baixo:
\[
mg-N=ma \quad\Rightarrow\quad N=m(g-a)=\Sexpr{Ndown}\,\mathrm{N}.
\]
\begin{answerlist}
  \item $\Sexpr{Nup}\,\mathrm{N}$
  \item $\Sexpr{Ndown}\,\mathrm{N}$
\end{answerlist}
\end{solution}

