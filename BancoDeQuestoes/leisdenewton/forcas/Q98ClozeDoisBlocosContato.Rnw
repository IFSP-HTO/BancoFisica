<<echo=FALSE, results=hide>>=
mA <- sample(c(2,3,4,5), 1)
mB <- sample(c(4,5,6,8), 1)
a <- sample(c(2,3,4), 1)
F <- (mA+mB)*a
Fcont <- mB*a
@
\usepackage[utf8]{inputenc}

\begin{question}
Dois blocos A e B, de massas $\Sexpr{mA}\,\mathrm{kg}$ e $\Sexpr{mB}\,\mathrm{kg}$, estão em contato sobre uma superfície horizontal sem atrito. Uma força horizontal de módulo $\Sexpr{F}\,\mathrm{N}$ é aplicada ao bloco A, empurrando o conjunto.

Determine:
\begin{answerlist}
  \item a aceleração dos blocos, em $\mathrm{m/s^2}$;
  \item o módulo da força de contato exercida por A sobre B, em newtons.
\end{answerlist}
\end{question}

\begin{solution}
Considerando os dois blocos como um único sistema,
\[
a=\frac{F}{m_A+m_B}
=\frac{\Sexpr{F}}{\Sexpr{mA}+\Sexpr{mB}}
=\Sexpr{a}\,\mathrm{m/s^2}.
\]
No bloco B, a única força horizontal é a força de contato:
\[
F_{AB}=m_Ba=\Sexpr{mB}\cdot\Sexpr{a}
=\Sexpr{Fcont}\,\mathrm{N}.
\]
\begin{answerlist}
  \item $\Sexpr{a}\,\mathrm{m/s^2}$
  \item $\Sexpr{Fcont}\,\mathrm{N}$
\end{answerlist}
\end{solution}

