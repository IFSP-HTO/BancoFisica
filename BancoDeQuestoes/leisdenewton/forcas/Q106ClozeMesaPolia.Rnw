<<echo=FALSE, results=hide>>=
m1 <- sample(c(3,4,5,6),1)
m2 <- sample(c(2,3,4,5),1)
g <- 10
a <- m2*g/(m1+m2)
T <- m1*a
include_supplement("Q106ClozeMesaPolia.png", dir="../../figuras")
@
\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\begin{question}
Um bloco de massa $m_1=\Sexpr{m1}\,\mathrm{kg}$ está sobre uma mesa horizontal sem atrito. Ele está ligado, por um fio ideal e uma polia ideal, a um corpo suspenso de massa $m_2=\Sexpr{m2}\,\mathrm{kg}$. Considere $g=10\,\mathrm{m/s^2}$.
\begin{center}\includegraphics[width=0.66\linewidth,height=7.2cm,keepaspectratio]{Q106ClozeMesaPolia.png}\end{center}
Calcule: \begin{answerlist}\item a aceleração comum, em $\mathrm{m/s^2}$; \item a tensão no fio, em $\mathrm N$.\end{answerlist}
\end{question}
\begin{solution}
No bloco sobre a mesa, $T=m_1a$. No corpo suspenso, $m_2g-T=m_2a$. Logo
\[a=\frac{m_2g}{m_1+m_2}=\Sexpr{round(a,2)}\,\mathrm{m/s^2},\qquad T=m_1a=\Sexpr{round(T,2)}\,\mathrm N.\]
\end{solution}
