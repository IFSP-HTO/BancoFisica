<<echo=FALSE, results=hide>>=
# Adaptacao do exercicio 6: limite estatico com polia.
m_B <- sample(c(10, 20, 30, 40), 1)
mu_e <- sample(c(0.3, 0.4, 0.5, 0.6), 1)
g <- 10
m_A_max <- mu_e*m_B

png("Q07PoliaLimiteAtrito.png", width=1100, height=580, res=150)
par(mar=c(0,0,0,0), xaxs="i", yaxs="i")
plot.new(); plot.window(xlim=c(0,10), ylim=c(0,6), asp=1)
segments(0.5,3.0,7.2,3.0,lwd=3,col="#374151")
for (xx in seq(0.7,7.0,by=0.48))
  segments(xx,3.0,xx-0.20,2.78,col="#9ca3af")
rect(2.0,3.05,3.7,4.35,col="#e0ebf5",border="#1f2937",lwd=3)
text(2.85,3.7,"B",cex=1.5,font=2)
symbols(7.4,3.78,circles=0.38,inches=FALSE,add=TRUE,
        bg="#e5e7eb",fg="#1f2937",lwd=2)
points(7.4,3.78,pch=16,col="#1f2937",cex=0.7)
segments(3.7,4.16,7.4,4.16,lwd=2.5,col="#2563eb")
segments(7.78,3.78,7.78,2.45,lwd=2.5,col="#2563eb")
rect(7.28,1.15,8.28,2.45,col="#e0ebf5",border="#1f2937",lwd=3)
text(7.78,1.8,"A",cex=1.4,font=2)
dev.off()
include_supplement("Q07PoliaLimiteAtrito.png")
@
\usepackage[utf8]{inputenc}
\begin{question}
O bloco $B$, de massa $\Sexpr{m_B}$ kg, permanece sobre uma
mesa horizontal e está ligado, por fio e polia ideais, ao bloco
suspenso $A$.

\begin{center}
\includegraphics[width=0.66\linewidth,keepaspectratio]{Q07PoliaLimiteAtrito.png}
\end{center}

O coeficiente de atrito estático entre $B$ e a mesa é
$\mu_e=\Sexpr{mu_e}$. Qual é a \textbf{maior massa} do bloco
$A$, em quilogramas, que permite manter o sistema em repouso?
Considere $g=10\,\mathrm{m/s^2}$.
\end{question}

\begin{solution}
No equilíbrio, a tração é $T=m_Ag$. O atrito estático sobre
$B$ pode equilibrá-la até o limite $f_{e,\max}=\mu_e m_Bg$.
Assim,
\[
 m_Ag \leq \mu_e m_Bg
 \quad\Rightarrow\quad
 m_{A,\max}=\mu_e m_B
 =\Sexpr{mu_e}\cdot\Sexpr{m_B}
 =\Sexpr{m_A_max}\,\mathrm{kg}.
\]
\end{solution}

