<<echo=FALSE, results=hide>>=
# Adaptacao do exercicio 20: tres blocos, dois fios e duas polias.
m_A <- sample(c(6, 8, 10, 12), 1)
m_B <- sample(c(10, 15, 20), 1)
m_C <- m_B+sample(c(8, 10, 12), 1)
mu_d <- sample(c(0.2, 0.3, 0.4), 1)
g <- 10
f_at <- mu_d*m_A*g
a_exact <- ((m_C-m_B)*g-f_at)/(m_A+m_B+m_C)
stopifnot(a_exact>0)
a <- round(a_exact, 2)

png("Q10TresBlocosAtrito.png", width=1200, height=630, res=150)
par(mar=c(0,0,0,0), xaxs="i", yaxs="i")
plot.new(); plot.window(xlim=c(0,11), ylim=c(0,6), asp=1)
segments(2.0,3.0,8.5,3.0,lwd=3,col="#374151")
for (xx in seq(2.3,8.25,by=0.48))
  segments(xx,3.0,xx-0.20,2.78,col="#9ca3af")
rect(4.25,3.04,6.35,4.4,col="#e0ebf5",border="#1f2937",lwd=3)
text(5.3,3.75,"A",cex=1.6,font=2)
symbols(c(1.9,8.7),c(3.88,3.88),circles=c(0.35,0.35),
        inches=FALSE,add=TRUE,bg="#e5e7eb",fg="#1f2937",lwd=2)
points(c(1.9,8.7),c(3.88,3.88),pch=16,cex=0.6,col="#374151")
segments(1.9,4.23,4.25,4.23,lwd=2.5,col="#2563eb")
segments(6.35,4.23,8.7,4.23,lwd=2.5,col="#2563eb")
segments(1.55,3.88,1.55,2.3,lwd=2.5,col="#2563eb")
segments(9.05,3.88,9.05,2.3,lwd=2.5,col="#2563eb")
rect(1.1,1.1,2.0,2.3,col="#e0ebf5",border="#1f2937",lwd=3)
rect(8.6,1.1,9.5,2.3,col="#e0ebf5",border="#1f2937",lwd=3)
text(1.55,1.7,"B",cex=1.4,font=2)
text(9.05,1.7,"C",cex=1.4,font=2)
dev.off()
include_supplement("Q10TresBlocosAtrito.png")
@
\usepackage[utf8]{inputenc}
\begin{question}
O bloco $A$, de massa $\Sexpr{m_A}$ kg, desliza sobre uma
mesa horizontal, com coeficiente de atrito cinético
$\mu_d=\Sexpr{mu_d}$. Ele está ligado por dois fios ideais
independentes que passam por polias ideais aos blocos suspensos
$B$ e $C$, de massas $\Sexpr{m_B}$ kg e
$\Sexpr{m_C}$ kg, respectivamente.

\begin{center}
\includegraphics[width=0.71\linewidth,keepaspectratio]{Q10TresBlocosAtrito.png}
\end{center}

O bloco $C$ desce, enquanto $A$ se desloca para a direita.
Determine o módulo da aceleração comum, em $\mathrm{m/s^2}$,
com duas casas decimais. Adote $g=10\,\mathrm{m/s^2}$.
\end{question}

\begin{solution}
Como os fios são inextensíveis, os blocos têm acelerações de
mesmo módulo. Tomando $A$ para a direita, $B$ para cima e
$C$ para baixo como sentidos positivos:
\[
\begin{array}{rl}
  T_C-T_B-\mu_d m_Ag &=m_Aa,\\
  T_B-m_Bg &=m_Ba,\\
  m_Cg-T_C &=m_Ca.
\end{array}
\]
Somando as equações, as trações se cancelam:
\[
 a=\frac{(m_C-m_B)g-\mu_dm_Ag}{m_A+m_B+m_C}
 =\Sexpr{a}\,\mathrm{m/s^2}.
\]
O valor é positivo, como previsto pelo sentido do movimento.
\end{solution}

