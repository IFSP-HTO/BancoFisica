<<echo=FALSE, results=hide>>=
m <- sample(c(10,15,20), 1)
F <- sample(c(75,100,125), 1)
mu <- sample(c(0.1,0.2), 1)
g <- 10
cos37 <- 0.8
sin37 <- 0.6
N <- m*g - F*sin37
fat <- mu*N
Fx <- F*cos37
a <- (Fx-fat)/m
@
\usepackage[utf8]{inputenc}

\begin{question}
Uma caixa de massa $\Sexpr{m}\,\mathrm{kg}$ é puxada sobre um piso horizontal por uma força de módulo $\Sexpr{F}\,\mathrm{N}$ que forma $37^\circ$ acima da horizontal. O coeficiente de atrito cinético é $\Sexpr{mu}$. Adote $g=10\,\mathrm{m/s^2}$, $\sin 37^\circ=0,6$ e $\cos 37^\circ=0,8$.

Determine:
\begin{answerlist}
  \item o módulo da força normal, em newtons;
  \item o módulo da força de atrito cinético, em newtons;
  \item a aceleração horizontal da caixa, em $\mathrm{m/s^2}$.
\end{answerlist}
\end{question}

\begin{solution}
A componente vertical da força aplicada reduz a normal:
\[
N=mg-F\sin37^\circ
=\Sexpr{m}\cdot10-\Sexpr{F}\cdot0,6
=\Sexpr{N}\,\mathrm{N}.
\]
O atrito cinético vale
\[
f_{at}=\mu N
=\Sexpr{round(fat,2)}\,\mathrm{N}.
\]
Na horizontal,
\[
F_x=F\cos37^\circ=\Sexpr{Fx}\,\mathrm{N}.
\]
Logo,
\[
a=\frac{F_x-f_{at}}{m}
=\Sexpr{round(a,2)}\,\mathrm{m/s^2}.
\]
\begin{answerlist}
  \item $\Sexpr{N}\,\mathrm{N}$
  \item $\Sexpr{round(fat,2)}\,\mathrm{N}$
  \item $\Sexpr{round(a,2)}\,\mathrm{m/s^2}$
\end{answerlist}
\end{solution}

