<<echo=FALSE, results=hide>>=
#Programado por: Marcelo C.

m <- sample(10:50, 1)
uest <- sample(seq(0.4, 0.6, by=0.01), 1)
udin <- sample(seq(0.2, uest - 0.05, by=0.01), 1)
theta <- sample(20:50, 1)
g <- 10
rad <- theta*pi/180
N <- m*g*cos(rad)
Fat_max <- uest*N
Fa <- m*g*sin(rad)

if (Fa > Fat_max) {
  resp1 <- "S"
  resp2 <- round(udin*N, 2)
  resp3 <- round((Fa - udin*N)/m, 2)
} else {
  resp1 <- "N"
  resp2 <- round(Fa, 2)
  resp3 <- 0
}
##Imagem
include_supplement("Q02Atrito.png")
@
\usepackage[utf8]{inputenc}

\begin{question}

Um bloco de $\Sexpr{m}$ kg é colocado sobre um plano inclinado que faz um ângulo $\theta = \Sexpr{theta}$ $^\circ$ com a horizontal. Sabe-se que o coeficiente de atrito estático e cinético entre o bloco e o plano valem, respectivamente, $\Sexpr{uest}$ e $\Sexpr{udin}$. Responda o que se pede: (adote $g = 10 m/s^2$)

\begin{figure}[h!]
  \centering
  \includegraphics[height=5cm, keepaspectratio]{Q02Atrito.png}
\end{figure}
  
  \begin{answerlist}

    \item O bloco entrará em movimento? Responda "S" para Sim e "N" para Não
    .
    \item Qual o módulo da força de atrito aplicada sobre o bloco.
    \item Qual o módulo da aceleração do bloco.
  
  \end{answerlist}

\end{question}

%% SOLUTION
\begin{solution}
A componente do peso paralela ao plano é
$P_{\parallel}=mg\sin\theta=\Sexpr{round(Fa,2)}\,\mathrm{N}$.
A normal é $N=mg\cos\theta$, de modo que o atrito
\textbf{estático máximo} vale
\[
 f_{e,\max}=\mu_e mg\cos\theta
 =\Sexpr{round(Fat_max,2)}\,\mathrm{N}.
\]
\begin{answerlist}
  \item A comparação entre $P_{\parallel}$ e $f_{e,\max}$ mostra
  que o bloco entra em movimento? \textbf{\Sexpr{resp1}}.
  \item Se permanece em repouso, a força de atrito equilibra
  $P_{\parallel}$. Se desliza, o atrito é cinético,
  $f_d=\mu_d mg\cos\theta$.
  Neste caso, $f_{\mathrm{at}}=\Sexpr{resp2}\,\mathrm{N}$.
  \item Em repouso, $a=0$. Caso haja deslizamento,
  \[
    a=g(\sin\theta-\mu_d\cos\theta).
  \]
  Portanto, $a=\Sexpr{resp3}\,\mathrm{m/s^2}$.
\end{answerlist}
\end{solution}

