<<echo=FALSE, results=hide>>=
  #Programado por: Jmduly
  
  press1 <- sample(seq(from=2,to=8,by=1),1)
  
  vol1   <- sample(seq(from=90,to=150,by=1),1)
  temp1  <- sample(seq(from=17,to=27,by=1),1)
  
  n_mols <- press1*vol1/(0.082*(temp1+273))
  
  resp1 <- round(n_mols*6.02, digits = 2)
  
@
  
\usepackage[utf8]{inputenc}
  
\begin{question}
  
Um gás ideal ocupa um volume de $\Sexpr{vol1}$ litros, sob pressão de $\Sexpr{press1}$ atm, à temperatura de $\Sexpr{temp1}$ °C. Considere $N_A=6{,}02\times10^{23}\,\mathrm{mol^{-1}}$ e $R=0{,}082\,\mathrm{atm\,L/(mol\,K)}$. Determine o número de moléculas, fornecendo como resposta apenas o coeficiente que multiplica $10^{23}$.

\end{question}
  
%% SOLUTION
\begin{solution}
Primeiro determinamos a quantidade de matéria pela equação do gás ideal:
\[
  PV=nRT.
\]

A temperatura absoluta é
\[
  T=\Sexpr{temp1}+273
   =\Sexpr{temp1+273}\,\mathrm{K}.
\]

Assim,
\[
  n=
  \frac{\Sexpr{press1}\cdot\Sexpr{vol1}}
       {0{,}082\cdot\Sexpr{temp1+273}}
  =\Sexpr{round(n_mols,3)}\,\mathrm{mol}.
\]

O número de moléculas é
\[
  N=nN_A.
\]
Logo,
\[
  N=
  \Sexpr{round(n_mols,3)}
  \cdot6{,}02\times10^{23}
  \approx
  \Sexpr{resp1}\times10^{23}.
\]

Portanto, o coeficiente solicitado é \(\Sexpr{resp1}\).

\end{solution}
  
