<<echo=FALSE, results=hide>>=
  #Programado por: Jmduly
  
## Funções
nota_cient <- function(x,digits) {
  if (x==0) return("0")
  ord <- floor(log(abs(x),10))
  x <- x / 10^ord
  if (!missing(digits)) x <- format(x,digits=digits)
  if (ord==0) return(as.character(x))
  return(paste(x,"\\\\times 10^{",ord,"}",sep=""))
}

## Questões

  press1 <- sample(seq(from=4,to=12,by=1),1)
  
  press1_pa <- press1*10^4
  
  temp1  <- sample(seq(from=273,to=303,by=1),1)
  
  temp2  <- sample(seq(from=310,to=330,by=1),1)
  
  vol1   <- sample(seq(from=2,to=10,by=1),1)
  
  vol2   <- sample(seq(from=13,to=20,by=1),1)
  
  resp1  <- round((temp2*press1_pa*vol1)/(vol2*temp1), digits = 2)
  
@
  
\usepackage[utf8]{inputenc}
  
\begin{question}
  
  Em condições tais que um gás se comporta como ideal, as variáveis de estado assumem os valores $\Sexpr{temp1}$ K, $\Sexpr{vol1}$ m³ e $\Sexpr{nota_cient(press1_pa)}$ Pa, num estado A. Sofrendo certa transformação, o sistema chega ao estado B, em que os valores são $\Sexpr{temp2}$ K, $\Sexpr{vol2}$ m³ e p. Determine o valor de p em Pa. OBS: apresente o resultado com duas casas decimais.

\end{question}
  
  %% SOLUTION
\begin{solution}
Para uma quantidade fixa de gás ideal, entre dois estados vale
\[
  \frac{P_1V_1}{T_1}
  =
  \frac{P_2V_2}{T_2}.
\]

Isolando \(P_2\),
\[
  P_2=
  P_1\frac{V_1}{V_2}\frac{T_2}{T_1}.
\]

Substituindo,
\[
  P_2=
  \Sexpr{nota_cient(press1_pa)}
  \frac{\Sexpr{vol1}}{\Sexpr{vol2}}
  \frac{\Sexpr{temp2}}{\Sexpr{temp1}}
  =\Sexpr{resp1}\,\mathrm{Pa}.
\]

\end{solution}
  
