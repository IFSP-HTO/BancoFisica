<<echo=FALSE, results=hide>>=
## Exercício 2 (slides): velocidade angular média

r  <- sample(c(40, 50, 60, 80), 1)           ## raio (m)
v  <- sample(c(18, 36, 54, 72, 90), 1)       ## velocidade escalar (km/h)
t  <- sample(c(5, 10, 15, 20), 1)            ## tempo (s)

v_ms <- v / 3.6
omega_exact <- v_ms / r
omega  <- round(omega_exact, 3)               ## velocidade angular média (rad/s)
angulo <- round(omega_exact * t, 3)           ## ângulo descrito (rad)
@

\begin{question}

Uma circunferência de raio $\Sexpr{r}$ m é percorrida durante $\Sexpr{t}$ s por um móvel com velocidade escalar de $\Sexpr{v}$ km/h. Determine:

\begin{answerlist}
  \item A velocidade angular média do móvel, em rad/s. \textit{Dê sua resposta com três casas decimais.}
  \item O ângulo descrito pelo móvel nos $\Sexpr{t}$ s, em rad. \textit{Dê sua resposta com três casas decimais.}
\end{answerlist}
\end{question}

\begin{solution}
Primeiro convertemos a velocidade linear para o SI:
\[
  v=\frac{\Sexpr{v}}{3{,}6}=\Sexpr{v_ms}\,\mathrm{m/s}.
\]
Para movimento circular,
\[
  v=\omega r.
\]
Logo,
\[
  \omega=\frac{v}{r}
        =\frac{\Sexpr{v_ms}}{\Sexpr{r}}
        =\Sexpr{omega}\,\mathrm{rad/s}.
\]
O ângulo descrito em \(\Sexpr{t}\) s é
\[
  \Delta\theta=\omega t
              =\Sexpr{angulo}\,\mathrm{rad}.
\]

\begin{answerlist}
  \item \Sexpr{omega} rad/s
  \item \Sexpr{angulo} rad
\end{answerlist}

\end{solution}

