<<echo=FALSE, results=hide>>=
## Exercício Q25 (slides): roda gigante

R <- sample(c(8, 10, 12), 1)     ## raio (m)
v <- sample(c(5, 6, 7), 1)       ## velocidade linear (m/s)

a <- round(v^2 / R, 1)           ## aceleração centrípeta (m/s²)
@
\usepackage[utf8]{inputenc}
\begin{question}

Uma roda gigante com raio igual a $\Sexpr{R}$ m está girando em torno de um eixo horizontal passando pelo seu centro. A velocidade linear constante de um passageiro em sua periferia é igual a $\Sexpr{v}$ m/s.

<<fig=TRUE, height=4.8, width=5.5, echo=FALSE, eps=FALSE, results=hide>>=
par(mar=c(0.3,0.3,0.3,0.3))
plot.new(); plot.window(xlim=c(-1.45,1.45), ylim=c(-1.55,1.45), asp=1)
symbols(0,0,circles=1.05,inches=FALSE,add=TRUE,lwd=2)
ang <- seq(0,2*pi,length.out=9)[-9]
for (aa in ang) segments(0,0,1.05*cos(aa),1.05*sin(aa),lwd=1.2)
points(0,0,pch=19,cex=0.8)
# cabines simples
for (aa in ang) {
  xx <- 1.05*cos(aa); yy <- 1.05*sin(aa)
  rect(xx-0.10,yy-0.08,xx+0.10,yy+0.08,lwd=1)
}
# passageiro no ponto mais baixo e aceleração para o centro
arrows(0,-1.02,0,-0.30,length=0.09,lwd=2)
text(0.12,-0.63,"a_c",font=2,pos=4)
segments(0,0,0,-1.05,lty=2,lwd=1.2)
text(0.13,-0.53,"R",font=2,pos=4)
text(0.13,0.08,"centro",cex=0.8,pos=4)
@

No ponto mais baixo do movimento circular, o módulo da aceleração do passageiro, em m/s², é de:

<<echo=FALSE, results=hide, results=tex>>=
aleat <- sample(1:4)
opts <- sort(unique(round(c(a, 0.1, 1.0, a*10, a/2), 1)))
if (length(opts) < 4) opts <- c(opts, 2*a)
opts <- opts[1:4]
questions <- numeric(4); solutions <- logical(4)
aleat <- sample(1:4)
for (i in 1:4) { questions[aleat[i]] <- opts[i]; solutions[aleat[i]] <- opts[i] == a }
answerlist(questions)
@
\end{question}

\begin{solution}
<<echo=FALSE, results=hide, results=tex>>=
answerlist(
  paste("\\textbf{", ifelse(solutions, "Verdadeiro", "Falso"), "}"))
@

O movimento é circular uniforme, logo a aceleração é centrípeta, apontando para o centro (no ponto mais baixo, para cima):

$$a = \frac{v^2}{R} = \frac{\Sexpr{v}^2}{\Sexpr{R}} = \Sexpr{a} \text{ m/s}^2.$$
\end{solution}

