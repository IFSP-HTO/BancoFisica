<<echo=FALSE, results=hide>>=
## Exercício Q14 (slides): mecanismo com engrenagens A, B e C

Ra <- sample(c(8, 10, 12), 1)      ## raio de A (cm)
Rb <- sample(c(12, 15, 18), 1)     ## raio de B (cm)
Rc <- sample(c(4, 5, 6), 1)        ## raio de C (cm)
fA <- sample(c(60, 75, 90), 1)     ## frequência do motor (rpm)

pi_aprox <- 3.14
## A engrena com B: Ra*fA = Rb*fB; B e C no mesmo eixo
fB_exato <- fA * Ra / Rb
fB <- round(fB_exato, 2)
fC_exato <- fB_exato
## velocidade linear do ponto P na periferia de C, em cm/s
vP <- round(2 * pi_aprox * Rc * (fC_exato / 60), 2)

include_supplement("Q18MecanismoEngrenagens.jpg")
@
\usepackage[utf8]{inputenc}
\begin{question}

No mecanismo esquematizado, o motor aciona a engrenagem A com uma frequência de $\Sexpr{fA}$ rpm. As engrenagens B e C possuem o mesmo eixo. Sendo $R_A = \Sexpr{Ra}$ cm, $R_B = \Sexpr{Rb}$ cm e $R_C = \Sexpr{Rc}$ cm, determine:

\fbox{\includegraphics[height=4.5cm,keepaspectratio]{Q18MecanismoEngrenagens.jpg}}

\begin{answerlist}
  \item A frequência de rotação, em rpm, das engrenagens B e C. \textit{Dê sua resposta com duas casas decimais.}
  \item A velocidade linear, em cm/s, do ponto P pertencente à periferia da engrenagem C. \textit{Dê sua resposta com duas casas decimais. Adote $\pi = 3{,}14$.}
\end{answerlist}
\end{question}

\begin{solution}

\begin{answerlist}
  \item A engrena com B (mesma velocidade linear na borda): $f_B = f_A \dfrac{R_A}{R_B} = \Sexpr{fA}\cdot\dfrac{\Sexpr{Ra}}{\Sexpr{Rb}} = \Sexpr{fB}$ rpm. Como B e C giram no mesmo eixo, $f_C = f_B$.
  \item Mantendo o valor não arredondado de $f_C$ no cálculo, $v_P = 2\pi R_C f_C = 2\cdot 3{,}14\cdot\Sexpr{Rc}\cdot\dfrac{\Sexpr{fA}\,\Sexpr{Ra}}{60\,\Sexpr{Rb}} = \Sexpr{vP}$ cm/s.
\end{answerlist}
\end{solution}

