\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}
O desenho mostra a refração de luz monocromática da água para uma lâmina de vidro. Os ângulos dos raios com a normal à interface são $\theta_{\mathrm{AG}}$ e $\theta_{\mathrm{VI}}$, respectivamente. Qual é a expressão para a razão entre os índices de refração $n_{\mathrm{AG}}/n_{\mathrm{VI}}$?

\begin{center}
\includegraphics[width=0.64\linewidth,keepaspectratio]{Humanitas2026Q39Refracao.png}
\end{center}

\begin{answerlist}
  \item $\dfrac{\theta_{\mathrm{AG}}}{\theta_{\mathrm{VI}}}$
  \item $\dfrac{\theta_{\mathrm{VI}}}{\theta_{\mathrm{AG}}}$
  \item $\sin\theta_{\mathrm{AG}}\,\sin\theta_{\mathrm{VI}}$
  \item $\dfrac{\sin\theta_{\mathrm{AG}}}{\sin\theta_{\mathrm{VI}}}$
  \item $\dfrac{\sin\theta_{\mathrm{VI}}}{\sin\theta_{\mathrm{AG}}}$
\end{answerlist}
\end{question}

\begin{solution}
Pela lei de Snell, $n_{\mathrm{AG}}\sin\theta_{\mathrm{AG}}=n_{\mathrm{VI}}\sin\theta_{\mathrm{VI}}$. Portanto,
\[
\frac{n_{\mathrm{AG}}}{n_{\mathrm{VI}}}=\frac{\sin\theta_{\mathrm{VI}}}{\sin\theta_{\mathrm{AG}}}.
\]
Alternativa \textbf{E}.
\end{solution}

