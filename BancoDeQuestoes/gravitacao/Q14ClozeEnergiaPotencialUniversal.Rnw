<<echo=FALSE, results=hide>>=
GM <- 4e14
m <- sample(c(100,200,300,500),1)
r1 <- sample(c(8,10,12),1)*1e6
mult <- sample(c(1.5,2,2.5),1)
r2 <- mult*r1
U1 <- -GM*m/r1
U2 <- -GM*m/r2
dU <- U2-U1
@

\usepackage[utf8]{inputenc}

\begin{question}
Considere um planeta para o qual $GM=4{,}0\times10^{14}\,\mathrm{m^3/s^2}$. Uma sonda de massa $\Sexpr{m}\,\mathrm{kg}$ é deslocada lentamente de uma distância $\Sexpr{r1/1e6}\times10^6\,\mathrm{m}$ para $\Sexpr{r2/1e6}\times10^6\,\mathrm{m}$ em relação ao centro do planeta.

Usando $U=-GMm/r$, determine:
\begin{answerlist}
  \item a energia potencial gravitacional inicial, em megajoules;
  \item a variação $\Delta U=U_f-U_i$, em megajoules.
\end{answerlist}
\end{question}

\begin{solution}
Inicialmente,
\[
U_i=-\frac{GMm}{r_i}=\Sexpr{round(U1/1e6,3)}\,\mathrm{MJ}.
\]
Na posição final,
\[
U_f=-\frac{GMm}{r_f}=\Sexpr{round(U2/1e6,3)}\,\mathrm{MJ}.
\]
Logo,
\[
\Delta U=U_f-U_i=\Sexpr{round(dU/1e6,3)}\,\mathrm{MJ}.
\]
Como a sonda se afasta do planeta, a energia potencial aumenta, tornando-se menos negativa.

\begin{answerlist}
  \item $\Sexpr{round(U1/1e6,3)}\,\mathrm{MJ}$
  \item $\Sexpr{round(dU/1e6,3)}\,\mathrm{MJ}$
\end{answerlist}
\end{solution}

