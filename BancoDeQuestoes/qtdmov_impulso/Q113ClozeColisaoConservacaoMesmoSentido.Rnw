<<echo=FALSE, results=hide>>=
casos <- data.frame(
  m1  = c(6, 2, 4, 3),
  m2  = c(4, 3, 2, 2),
  v1i = c(4, 5, 3, 4),
  v2i = c(2, 1, 1, 1),
  v1f = c(2.4, 2, 2, 2),
  v2f = c(4.4, 3, 3, 4)
)
i <- sample(seq_len(nrow(casos)), 1)
m1  <- casos$m1[i]
m2  <- casos$m2[i]
v1i <- casos$v1i[i]
v2i <- casos$v2i[i]
v1f <- casos$v1f[i]
v2f <- casos$v2f[i]

pi <- m1*v1i + m2*v2i
pf <- m1*v1f + m2*v2f

fmt <- function(x, d = 1) formatC(x, format = "f", digits = d, decimal.mark = ",")
include_supplement("Q113ColisaoMesmoSentido.png")
@

\usepackage[utf8]{inputenc}
\usepackage{graphicx}

\begin{question}

(Adaptada do material \textit{Colisões}) Duas bolas, 1 e 2, de massas
$m_1=\Sexpr{fmt(m1,1)}\,\mathrm{kg}$ e
$m_2=\Sexpr{fmt(m2,1)}\,\mathrm{kg}$, movem-se sobre uma mesma linha horizontal.
As velocidades antes e depois da colisão estão representadas na figura.

\begin{center}
\includegraphics[width=13.5cm,keepaspectratio]{Q113ColisaoMesmoSentido.png}
\end{center}

Considere positivo o sentido indicado pelas setas para a direita. Para esta colisão,
\[
v_1=\Sexpr{fmt(v1i,1)}\,\mathrm{m/s},\qquad
v_2=\Sexpr{fmt(v2i,1)}\,\mathrm{m/s},
\]
\[
v'_1=\Sexpr{fmt(v1f,1)}\,\mathrm{m/s},\qquad
v'_2=\Sexpr{fmt(v2f,1)}\,\mathrm{m/s}.
\]

Calcule:

\begin{answerlist}
  \item a quantidade de movimento total do sistema antes da colisão, em $\mathrm{kg\,m/s}$;
  \item a quantidade de movimento total do sistema depois da colisão, em $\mathrm{kg\,m/s}$.
\end{answerlist}

A partir dos resultados, verifique se a quantidade de movimento total foi conservada.

\end{question}

\begin{solution}

Antes da colisão,
\[
p_i=m_1v_1+m_2v_2
=\Sexpr{fmt(m1,1)}\cdot\Sexpr{fmt(v1i,1)}
+\Sexpr{fmt(m2,1)}\cdot\Sexpr{fmt(v2i,1)}
=\Sexpr{fmt(pi,1)}\,\mathrm{kg\,m/s}.
\]

Depois da colisão,
\[
p_f=m_1v'_1+m_2v'_2
=\Sexpr{fmt(m1,1)}\cdot\Sexpr{fmt(v1f,1)}
+\Sexpr{fmt(m2,1)}\cdot\Sexpr{fmt(v2f,1)}
=\Sexpr{fmt(pf,1)}\,\mathrm{kg\,m/s}.
\]

Como $p_i=p_f$, a quantidade de movimento total do sistema foi conservada.

\begin{answerlist}
  \item $\Sexpr{fmt(pi,1)}\,\mathrm{kg\,m/s}$
  \item $\Sexpr{fmt(pf,1)}\,\mathrm{kg\,m/s}$
\end{answerlist}

\end{solution}

