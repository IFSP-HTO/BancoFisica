#Marcelo C.
include_supplement("Q07estce.jpg")

Fa <- sample(seq(from=1,to=200,by=1),1)
resp <- numeric(5)

resp[1] <- Fa*0.2
resp[2] <- Fa*0.1
resp[3] <- Fa*0.08
resp[4] <- Fa*0.08
resp[5] <- Fa*0.08
@
\usepackage{graphicx}
\usepackage[portuguese]{babel}

\begin{question}

Calcule o momento aplicado pela força $F$, em $N.m$, nas barras com relação ao eixo de rotação O em cada um dos ítens. Considere a força $F = \Sexpr{Fa} N$.

  \includegraphics[height=6cm,keepaspectratio]{Q07estce.jpg}

  \begin{answerlist}
    \item 
    \item 
    \item 
    \item 
    \item 
  \end{answerlist}

\end{question}

\begin{solution}
O módulo do momento de uma força em relação a \(O\) pode ser escrito como
\[
  \tau=F\,d_\perp,
\]
em que \(d_\perp\) é a distância perpendicular de \(O\) à linha de ação da força.

Na figura:

\begin{answerlist}
  \item \(d_\perp=0{,}20\,\mathrm{m}\), então
  \[
    \tau=\Sexpr{Fa}\cdot0{,}20=\Sexpr{resp[1]}\,\mathrm{N\,m}.
  \]

  \item \(d_\perp=0{,}10\,\mathrm{m}\), então
  \[
    \tau=\Sexpr{Fa}\cdot0{,}10=\Sexpr{resp[2]}\,\mathrm{N\,m}.
  \]

  \item A distância perpendicular indicada é \(8\,\mathrm{cm}=0{,}08\,\mathrm{m}\):
  \[
    \tau=\Sexpr{Fa}\cdot0{,}08=\Sexpr{resp[3]}\,\mathrm{N\,m}.
  \]

  \item A linha de ação é horizontal e está \(8\,\mathrm{cm}\) abaixo de \(O\):
  \[
    \tau=\Sexpr{Fa}\cdot0{,}08=\Sexpr{resp[4]}\,\mathrm{N\,m}.
  \]

  \item A linha de ação é horizontal e está \(8\,\mathrm{cm}\) acima de \(O\):
  \[
    \tau=\Sexpr{Fa}\cdot0{,}08=\Sexpr{resp[5]}\,\mathrm{N\,m}.
  \]
\end{answerlist}

\end{solution}

