<<echo=FALSE, results=hide>>=
L <- sample(c(0.60, 0.90, 1.20, 1.50), 1)
g <- 10
L0 <- 2*L/3
T <- 2*pi*sqrt(L0/g)
fmt <- function(x, d=2) formatC(x, format="f", digits=d, decimal.mark=",")
@
\usepackage[utf8]{inputenc}

\begin{question}

Uma barra homogênea de comprimento $L=\Sexpr{fmt(L,2)}\,\mathrm{m}$ pode oscilar em um plano vertical em torno de uma articulação em uma de suas extremidades, como mostra o esquema. Para pequenas oscilações, trate-a como um pêndulo físico. Considere $g=10\,\mathrm{m/s^2}$.

<<fig=TRUE, height=4.5, width=4.5, echo=FALSE, eps=FALSE, results=hide>>=
par(mar=c(0.5,0.5,0.5,0.5))
plot.new(); plot.window(xlim=c(-1,1), ylim=c(-1.2,0.4), asp=1)
segments(0,0, 0,-1, lwd=7)
points(0,0,pch=19,cex=1.2)
points(0,-0.5,pch=19,cex=1)
text(0.12,0,"pivô",pos=4)
text(0.12,-0.5,"CM",pos=4)
arrows(-0.35,0,-0.35,-1,code=3,length=0.08)
text(-0.43,-0.5,"L",srt=90)
@

Para uma barra homogênea pivotada na extremidade,
\[
I=\frac13mL^2,\qquad h=\frac{L}{2},
\]
e o comprimento equivalente de pêndulo simples é $L_0=I/(mh)$.

Determine:
\begin{answerlist}
  \item o comprimento equivalente $L_0$, em metros;
  \item o período de pequenas oscilações, em segundos.
\end{answerlist}

\end{question}

\begin{solution}

Usando $L_0=I/(mh)$,
\[
L_0=\frac{(1/3)mL^2}{m(L/2)}=\frac{2L}{3}.
\]
Assim,
\[
L_0=\frac{2\cdot\Sexpr{fmt(L,2)}}{3}
=\Sexpr{fmt(L0,2)}\,\mathrm{m}.
\]
O período é o mesmo de um pêndulo simples de comprimento $L_0$:
\[
T=2\pi\sqrt{\frac{L_0}{g}}
=2\pi\sqrt{\frac{\Sexpr{fmt(L0,2)}}{10}}
\approx\Sexpr{fmt(T,2)}\,\mathrm{s}.
\]

\begin{answerlist}
  \item $\Sexpr{fmt(L0,2)}\,\mathrm{m}$;
  \item $\Sexpr{fmt(T,2)}\,\mathrm{s}$.
\end{answerlist}

\end{solution}

