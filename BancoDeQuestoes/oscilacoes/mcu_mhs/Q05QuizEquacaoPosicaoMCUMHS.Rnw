<<echo=FALSE, results=hide>>=
Afig <- 1
theta <- sample(c(pi/6, pi/4, pi/3, 2*pi/3), 1)
xp <- Afig * cos(theta)
yp <- Afig * sin(theta)
ang <- seq(0, 2*pi, length.out = 500)
@
\usepackage[utf8]{inputenc}

\begin{question}

Considere uma partícula de referência que gira em sentido anti-horário com velocidade angular constante $\omega$ em uma circunferência de raio $A$. No instante $t=0$, sua posição angular é $\phi$. Em qualquer instante,
\[
\theta(t)=\omega t+\phi.
\]

O esquema mostra a projeção da posição da partícula sobre o eixo $x$.

<<fig=TRUE, height=5, width=6, echo=FALSE, eps=FALSE, results=hide>>=
par(mar = c(3.8, 1.0, 0.8, 0.8))
plot(Afig*cos(ang), Afig*sin(ang), type = "l", lwd = 2, asp = 1,
     axes = FALSE, xlab = "", ylab = "",
     xlim = c(-1.3, 1.3), ylim = c(-1.15, 1.3))
abline(h = 0, v = 0, lty = 3)
segments(0, 0, xp, yp, lwd = 2)
segments(xp, yp, xp, 0, lty = 2)
points(xp, yp, pch = 19, cex = 1.2)
points(xp, 0, pch = 19, cex = 1.2)
tt <- seq(0, theta, length.out = 80)
lines(0.42*cos(tt), 0.42*sin(tt), lwd = 1.5)
text(0.58*cos(theta/2), 0.58*sin(theta/2), labels = expression(theta))
text(xp, yp, labels = "P'", pos = 3)
text(xp, 0, labels = "P", pos = 1)
axis(1, at = c(-1, 0, 1), labels = c("-A", "0", "A"))
mtext("eixo x", side = 1, line = 2.2)
@

Qual expressão fornece a posição $x(t)$ da projeção?

\begin{answerlist}
  \item $x(t)=A\cos(\omega t+\phi)$.
  \item $x(t)=A\sin(\omega t+\phi)$.
  \item $x(t)=\omega A\cos(\omega t+\phi)$.
  \item $x(t)=A\cos(\omega t-\phi)$ para qualquer escolha da posição inicial.
  \item $x(t)=A\cos(t+\phi/\omega)$.
\end{answerlist}

\end{question}

\begin{solution}

A coordenada $x$ é a componente horizontal do vetor posição de módulo $A$. Pela geometria da projeção,
\[
x=A\cos\theta.
\]
Como a posição angular evolui uniformemente segundo
\[
\theta=\omega t+\phi,
\]
segue que
\[
\boxed{x(t)=A\cos(\omega t+\phi)}.
\]
A constante $\phi$ é a fase inicial: ela registra a posição angular da partícula de referência no instante $t=0$.

\end{solution}

