<<echo=FALSE, results=hide>>=
phi_vals <- c(pi/6, pi/3, 2*pi/3, 5*pi/6)
phi_tex <- c("\\pi/6", "\\pi/3", "2\\pi/3", "5\\pi/6")
phi_labels <- paste0("$", phi_tex, "$")
i <- sample(seq_along(phi_vals), 1)
phi <- phi_vals[i]
correta <- phi_labels[i]
alternativas <- c(phi_labels, "$4\\pi/3$")
solutions <- alternativas == correta
ord <- sample(seq_along(alternativas))
alternativas <- alternativas[ord]
solutions <- solutions[ord]

xp <- cos(phi)
yp <- sin(phi)
ang <- seq(0, 2*pi, length.out = 500)
@
\usepackage[utf8]{inputenc}

\begin{question}

Uma partícula de referência executa MCU em sentido anti-horário. Sua posição angular é descrita por
\[
\theta(t)=\omega t+\phi,
\]
em que $\phi$ é a constante de fase. A figura representa a posição da partícula exatamente no instante $t=0$; o ângulo é medido a partir do semieixo positivo de $x$, no sentido anti-horário.

<<fig=TRUE, height=5, width=6, echo=FALSE, eps=FALSE, results=hide>>=
par(mar = c(3.8, 1.0, 0.8, 0.8))
plot(cos(ang), sin(ang), type = "l", lwd = 2, asp = 1,
     axes = FALSE, xlab = "", ylab = "",
     xlim = c(-1.35, 1.35), ylim = c(-1.2, 1.35))
abline(h = 0, v = 0, lty = 3)
segments(0, 0, xp, yp, lwd = 2)
segments(xp, yp, xp, 0, lty = 2)
points(xp, yp, pch = 19, cex = 1.2)
points(xp, 0, pch = 19, cex = 1.2)
tt <- seq(0, phi, length.out = 100)
lines(0.42*cos(tt), 0.42*sin(tt), lwd = 1.5)
text(0.58*cos(phi/2), 0.58*sin(phi/2), labels = expression(phi))
text(xp, yp, labels = "P'(t=0)", pos = 3)
axis(1, at = c(-1, 0, 1), labels = c("-A", "0", "A"))
mtext("eixo x", side = 1, line = 2.2)
@

Qual é o valor de $\phi$, no intervalo $0\leq\phi<2\pi$?

<<echo=FALSE, results=tex>>=
answerlist(alternativas)
@

\end{question}

\begin{solution}

No instante inicial,
\[
\theta(0)=\omega\cdot0+\phi=\phi.
\]
Portanto, a constante de fase é simplesmente a posição angular inicial da partícula de referência, medida com a convenção indicada na figura. Para a configuração mostrada,
\[
\phi=\Sexpr{phi_tex[i]}.
\]

A projeção inicia, consequentemente, na posição
\[
x(0)=A\cos\phi.
\]
A representação circular permite determinar não apenas o valor do cosseno, mas o quadrante correto da fase.

<<echo=FALSE, results=tex>>=
answerlist(ifelse(solutions, paste0('\\textbf{', alternativas, '}'), alternativas))
@

\end{solution}

