<<echo=FALSE, results=hide>>=
k <- 9e9
q1_u <- sample(c(2,3,4,5,6),1)
q2_u <- sample(c(2,4,5,6,8),1)
r_cm <- sample(c(20,30,40,50,60),1)
q1 <- q1_u*1e-6
q2 <- q2_u*1e-6
r <- r_cm/100
F <- k*q1*q2/r^2
F2 <- F/4
@

\usepackage[utf8]{inputenc}

\begin{question}
Duas pequenas esferas possuem cargas de mesmo sinal, de módulos $\Sexpr{q1_u}\,\mu\mathrm{C}$ e $\Sexpr{q2_u}\,\mu\mathrm{C}$, separadas por $\Sexpr{r_cm}\,\mathrm{cm}$ no vácuo. Considere $k=9,0\times10^9\,\mathrm{N\,m^2/C^2}$.

Determine:
\begin{answerlist}
  \item o módulo da força elétrica entre as esferas, em newtons;
  \item o novo módulo da força, em newtons, se a distância entre elas for duplicada sem alterar as cargas.
\end{answerlist}
\end{question}

\begin{solution}
Pela lei de Coulomb,
\[
F=k\frac{|q_1q_2|}{r^2}=\Sexpr{round(F,3)}\,\mathrm{N}.
\]
Ao duplicar a distância, a força fica dividida por $2^2=4$:
\[
F'=\frac{F}{4}=\Sexpr{round(F2,3)}\,\mathrm{N}.
\]
\begin{answerlist}
  \item $\Sexpr{round(F,3)}\,\mathrm{N}$
  \item $\Sexpr{round(F2,3)}\,\mathrm{N}$
\end{answerlist}
\end{solution}

