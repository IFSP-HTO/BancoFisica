<<echo=FALSE, results=hide>>=
k <- 9e9
q_u <- sample(c(2,3,4,5,6),1)
r_cm <- sample(c(20,30,40,50,60),1)
V <- k*q_u*1e-6/(r_cm/100)
U_mJ <- V*sample(c(1,2,3,4),1)*1e-6*1e3
qt_u <- U_mJ*1e-3/V*1e6
@

\usepackage[utf8]{inputenc}

\begin{question}
Uma carga puntiforme positiva $Q=\Sexpr{q_u}\,\mu\mathrm{C}$ produz um potencial elétrico em um ponto situado a $\Sexpr{r_cm}\,\mathrm{cm}$ dela. Considere $V=0$ no infinito e $k=9,0\times10^9\,\mathrm{N\,m^2/C^2}$. Nesse ponto é colocada uma carga positiva $q=\Sexpr{round(qt_u,0)}\,\mu\mathrm{C}$.

Determine:
\begin{answerlist}
  \item o potencial elétrico no ponto, em volts;
  \item a energia potencial elétrica da carga $q$, em milijoules.
\end{answerlist}
\end{question}

\begin{solution}
Para uma carga puntiforme,
\[
V=k\frac{Q}{r}=\Sexpr{round(V,0)}\,\mathrm{V}.
\]
A energia potencial é
\[
U=qV=\Sexpr{round(U_mJ,2)}\,\mathrm{mJ}.
\]
\begin{answerlist}
  \item $\Sexpr{round(V,0)}\,\mathrm{V}$
  \item $\Sexpr{round(U_mJ,2)}\,\mathrm{mJ}$
\end{answerlist}
\end{solution}

